@using Microsoft.AspNetCore.Components.Routing

@foreach (var entrada in Menu)
{
    var nome = entrada.Key;
    var item = entrada.Value;
    var filhos = item.Filhos ?? new Dictionary<string, NavMenuItem>();

    @if (!DeveExibir(item))
    {
        continue;
    }

    @if (item.EhGrupo)
    {
        <MudNavGroup Title="@nome" Icon="@(item.EhImagem ? null : item.Icone)" Expanded="false"
                     Class="@ClasseItem(item)">
            <TitleContent>
                @if (item.EhImagem)
                {
                    <span class="adi-nav-image-title">
                        <img src="@item.Icone" alt="" class="adi-nav-image-icon" />
                        <span>@nome</span>
                    </span>
                }
                else
                {
                    @nome
                }
            </TitleContent>
            <ChildContent>
                <NavMenuTree Menu="@filhos" />
            </ChildContent>
        </MudNavGroup>
    }
    else
    {
        <MudNavLink Href="@item.Rota" Match="NavLinkMatch.Prefix" Icon="@NavIconResolver.Resolve(item.Icone)" Class="adi-nav-item">
            @nome
        </MudNavLink>
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, NavMenuItem> Menu { get; set; } = new Dictionary<string, NavMenuItem>();

    private static string ClasseItem(NavMenuItem item) => item.EhImagem
        ? "adi-nav-item adi-nav-image"
        : "adi-nav-item";

    // O NavMenu usa a lista local como fonte principal. Uma página só fica
    // disponível para navegação depois que o desenvolvedor informa o ID
    // gerado no cadastro SQLite. A tela de catálogo continua listando os
    // itens sem ID para permitir a integração manual.
    private static bool DeveExibir(NavMenuItem item) => item.EhGrupo || item.Id.HasValue;

}
