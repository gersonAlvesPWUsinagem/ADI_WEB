@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using ADI_WEB.Components.Pages.RecursosHumano.Catraca.Cracha
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject JwtAuthenticationService _jwtAuthenticationService
@inject IDataSessionHelper DataSessionHelper
@inject ILogger<NavMenu> Logger
@inject FavoritoPaginaState FavoritosState
@inject IHttpContextAccessor HttpContextAccessor
@inject SessionExpirationState SessionExpirationState
@inject ICatracaService CatracaService

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudMessageBox @bind-Visible="_exibirSessaoExpirada"
               Title="Sessão expirada"
               Message="Sua sessão expirou. Entre novamente para continuar de onde parou.">
    <YesButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="RedirecionarAposExpiracaoAsync">
            Ir para o login
        </MudButton>
    </YesButton>
</MudMessageBox>

<MudLayout>
    @if (Loading.IsLoading)
    {
        <MudProgressLinear Color="Color.Secondary"
                           Indeterminate="true"
                           Size="Size.Small"
                           Style="position: fixed; top: 0; left: 0; right: 0; z-index: 2000; height: 4px;" />
    }
    @if (ShowAppBar)
    {
        var uri = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLower();
        var isHome = string.IsNullOrEmpty(uri) || uri == "/home" || uri == "/";
        var isSobreSistema = uri == "/sobre-o-sistema";

        <MudAppBar Dense="true"
                   Fixed="true"
                   Elevation="@(isHome || isSobreSistema ? 2 : 1)"
                   Color="Color.Inherit"
                   Style="@(isHome
                                                   ? "position: fixed; top: 0; left: 0; right: 0; z-index: 1300; background-color: transparent !important; background-image: none !important; color: #ffffff !important;"
                                                   : (isSobreSistema
                                                       ? "position: fixed; top: 0; left: 0; right: 0; z-index: 1300; background-color: #0f766e !important; color: #ffffff !important;"
                                                       : ""))">

        @if (ShowDrawer)
            {
                <MudIconButton Class="mr-1"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               Icon="@Icons.Material.Filled.Menu"
                               OnClick="@DrawerToggle" />
            }

            <!-- MOBILE: somente a imagem abre o menu -->
            @if (!_isAuthenticated && !isSobreSistema)
            {
                <div class="adi-mobile-nav" data-adi-mobile-menu>
                    <button type="button"
                            class="adi-mobile-nav__button"
                            data-adi-mobile-menu-button
                            aria-label="Abrir menu ADI"
                            aria-haspopup="true"
                            aria-expanded="false">
                        <img src="/ico_adi_2025.png" alt="ADI" class="adi-mobile-nav__logo" />
                    </button>
                    <div class="adi-mobile-nav__menu" data-adi-mobile-menu-panel role="menu">
                        <a href="/user/login" class="adi-mobile-nav__item" role="menuitem">Entrar</a>
                        <a href="/downloads" class="adi-mobile-nav__item" role="menuitem">Downloads</a>
                    </div>
                </div>

                <!-- DESKTOP: mantém a apresentação original -->
                <div class="adi-desktop-brand">
                    <MudStack AlignItems="AlignItems.Center" Row="true" Spacing="2">
                        <MudAvatar Size="Size.Small"
                                   Elevation="0"
                                   Class="pa-0"
                                   Style="background: transparent;">
                            <MudImage Src="ico_adi_2025.png"
                                      Alt="Logo ADI"
                                      ObjectFit="ObjectFit.Contain" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle1" Class="adi-logo-text">
                            INTRANET ADI
                        </MudText>
                    </MudStack>
                </div>
            }
            else
            {
                <!-- Usuário autenticado ou página Sobre: apresentação original -->
                <MudStack AlignItems="AlignItems.Center" Row="true" Spacing="2">
                    <MudAvatar Size="Size.Small"
                               Elevation="0"
                               Class="pa-0"
                               Style="background: transparent;">
                        <MudImage Src="ico_adi_2025.png"
                                  Alt="Logo ADI"
                                  ObjectFit="ObjectFit.Contain" />
                    </MudAvatar>
                    <span class="adi-desktop-brand__text">
                        <MudText Typo="Typo.subtitle1" Class="adi-logo-text">
                            INTRANET ADI
                        </MudText>
                    </span>
                </MudStack>
            }

            <!-- BOTÃO HOME (Exibido apenas em /sobre-o-sistema) -->
            @if (isSobreSistema)
            {
                <MudButton Class="ml-2 adi-menu-button px-2"
                           Color="Color.Inherit"
                           Href="/"
                           StartIcon="@Icons.Material.Outlined.Home"
                           Variant="Variant.Text">
                    Home
                </MudButton>
            }

            <!-- MENU CENTRAL (Oculto em /sobre-o-sistema e se autenticado) -->
            @if (!_isAuthenticated && !isSobreSistema)
            {
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudStack Class="ml-4"
                              Row="true"
                              Spacing="0">

                        <MudButton Class="adi-menu-button px-3"
                                   Color="Color.Inherit"
                                   Href="/#sobre-adi"
                                   StartIcon="@Icons.Material.Outlined.Info"
                                   Variant="Variant.Text">
                            Sobre o ADI
                        </MudButton>

                        <MudButton Class="adi-menu-button px-3"
                                   Color="Color.Inherit"
                                   Href="/#sobre-pw"
                                   StartIcon="@Icons.Material.Outlined.Business"
                                   Variant="Variant.Text">
                            Sobre a PWUSINAGEM
                        </MudButton>

                        <MudButton Class="adi-menu-button px-3"
                                   Color="Color.Inherit"
                                   Href="/#suporte-ajuda"
                                   StartIcon="@Icons.Material.Outlined.HelpOutline"
                                   Variant="Variant.Text">
                            Ajuda-me
                        </MudButton>
                    </MudStack>
                </MudHidden>
            }

            <MudSpacer />

            <!-- ÁREA DO USUÁRIO / BOTÕES DA DIREITA -->
            @if (_isAuthenticated)
            {
                <MudStack AlignItems="AlignItems.Center"
                          Row="true"
                          Spacing="1">

                    <MudIconButton Class="mr-1"
                                   Color="Color.Inherit"
                                   Icon="@DarkLightModeButtonIcon"
                                   OnClick="@DarkModeToggle"
                                   Size="Size.Small" />

                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudButton Class="px-2"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Outlined.Logout"
                                   OnClick="@EfetuarLogout"
                                   Variant="Variant.Text">
                            Sair
                        </MudButton>
                    </MudHidden>

                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             Dense="true"
                             TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <MudButton Class="px-1 px-md-2"
                                       Color="Color.Inherit"
                                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                       StartIcon="@Icons.Material.Outlined.AccountCircle"
                                       Variant="Variant.Text">
                                <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                                    @FirstName.Substring(0, Math.Min(FirstName.Length, 6))...
                                </MudHidden>
                                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                                    @FirstName
                                </MudHidden>
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudText Class="px-4 py-2" Typo="Typo.caption">
                                Conectado como <b>@FirstName</b>
                            </MudText>
                            <MudDivider />
                            <MudMenuItem Href="/configuracoes"
                                         Icon="@Icons.Material.Outlined.Settings">
                                Configurações
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Outlined.Logout"
                                         IconColor="Color.Error"
                                         OnClick="@EfetuarLogout">
                                Sair
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </MudStack>
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center"
                          Row="true"
                          Spacing="1">

                    @if (!isSobreSistema)
                    {
                        <!-- Botões visíveis apenas em telas médias para cima (Desktop) -->
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudButton Class="adi-menu-button px-2"
                                       Color="Color.Inherit"
                                       OnClick="@(() => Navigation.NavigateTo("/user/login"))"
                                       StartIcon="@Icons.Material.Outlined.Login"
                                       Variant="Variant.Text">
                                Entrar
                            </MudButton>

                            <MudButton Class="adi-menu-button px-2"
                                       Color="Color.Inherit"
                                       Href="/downloads"
                                       StartIcon="@Icons.Material.Outlined.Download"
                                       Variant="Variant.Text">
                                Downloads
                            </MudButton>
                        </MudHidden>
                    }

                    <MudIconButton Class="adi-desktop-only"
                                   Color="Color.Inherit"
                                   Icon="@DarkLightModeButtonIcon"
                                   OnClick="@DarkModeToggle"
                                   Size="Size.Small"
                                   Title="Alternar Tema" />
                    <button type="button"
                            class="adi-mobile-only adi-mobile-theme-button"
                            onclick="adiMobileThemeToggle()"
                            aria-label="Alternar tema">&#9789;</button>
                </MudStack>
            }
        </MudAppBar>
    }
    @if (ShowDrawer)
    {
        <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Width="260px" Elevation="2">
            <NavMenu />
        </MudDrawer>
    }

    <MudMainContent Class="@GetMainContentClass()">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _isAuthenticated;
    private MudTheme? _theme;
    private string? _currentPath;
    private string? _fullName;
    private string? _level;
    private string? _environment;
    private bool _exibirSessaoExpirada;
    private string _returnUrlAposExpiracao = "/main";
    private CancellationTokenSource? _notificacaoBiometriaCts;
    private long _ultimaNotificacaoBiometriaId;

    private bool IsLoginPage => _currentPath?.StartsWith("user/login", StringComparison.OrdinalIgnoreCase) == true;
    private bool IsPublicHome => string.IsNullOrEmpty(_currentPath) || _currentPath.Equals("home", StringComparison.OrdinalIgnoreCase) || _currentPath.Equals("/", StringComparison.OrdinalIgnoreCase);
    private bool ShowAppBar => !IsLoginPage;
    private bool ShowDrawer => _isAuthenticated && !IsLoginPage && !IsPublicHome;

    private string FirstName => string.IsNullOrWhiteSpace(_fullName)
        ? "Usuário"
        : _fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuário";

    private string SessionType => string.Join(" / ", new[] { _level, _environment }.Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override async Task OnInitializedAsync()
    {
        _isDarkMode = ThemePreference.GetInitialDarkMode(HttpContextAccessor);
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };

        UpdateCurrentPath();
        Navigation.LocationChanged += OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        SessionExpirationState.SessionExpired += OnSessionExpiredAsync;

        Loading.OnChange += OnLoadingChanged;

        await LoadAuthenticationStateAsync();
        if (_isAuthenticated && !IsLoginPage)
            await InicializarMonitorBiometriaAsync();
    }

    private async Task InicializarMonitorBiometriaAsync()
    {
        if (!_isAuthenticated || IsLoginPage || _notificacaoBiometriaCts is not null) return;
        _notificacaoBiometriaCts = new CancellationTokenSource();
        try
        {
            var resposta = await CatracaService.ListarNotificacoesBiometriaAsync(0);
            _ultimaNotificacaoBiometriaId = resposta.Value?.MaxBy(x => x.Id)?.Id ?? 0;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Não foi possível inicializar o monitor global de biometrias.");
        }

        _ = MonitorarBiometriasAsync(_notificacaoBiometriaCts.Token);
    }

    private async Task MonitorarBiometriasAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (!_isAuthenticated || IsLoginPage) break;
                var resposta = await CatracaService.ListarNotificacoesBiometriaAsync(_ultimaNotificacaoBiometriaId);
                foreach (var notificacao in (resposta.Value ?? []).OrderBy(x => x.Id))
                {
                    _ultimaNotificacaoBiometriaId = Math.Max(_ultimaNotificacaoBiometriaId, notificacao.Id);
                    if (notificacao.Sucesso)
                    {
                        await InvokeAsync(() => Snackbar.Add(notificacao.Mensagem, Severity.Success,
                            opcoes => { opcoes.VisibleStateDuration = 10000; opcoes.ShowCloseIcon = true; }));
                    }
                    else
                    {
                        await InvokeAsync(async () =>
                        {
                            var parametros = new DialogParameters<CatracaComunicacaoDialog>
                            {
                                { x => x.Mensagem, notificacao.Mensagem }
                            };
                            await DialogService.ShowAsync<CatracaComunicacaoDialog>("Falha na comunicação com a catraca", parametros,
                                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });
                        });
                    }
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "O monitor global de biometrias foi interrompido.");
        }
    }

    private async void OnLoadingChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSessionExpiredAsync(string returnUrl)
    {
        _isAuthenticated = false;
        PararMonitorBiometria();
        _returnUrlAposExpiracao = NormalizarReturnUrl(returnUrl);
        _exibirSessaoExpirada = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task RedirecionarAposExpiracaoAsync()
    {
        _exibirSessaoExpirada = false;
        await DataSessionHelper.ClearAsync();
        FavoritosState.Limpar();
        await _jwtAuthenticationService.LogoutAsync();

        var returnUrl = Uri.EscapeDataString(_returnUrlAposExpiracao);
        Navigation.NavigateTo($"/user/login?returnUrl={returnUrl}", forceLoad: true);
    }

    private async Task EfetuarLogout()
    {
        try
        {
            await _jwtAuthenticationService.LogoutAsync();
            FavoritosState.Limpar();

            Snackbar.Add("Sessão encerrada com sucesso.", Severity.Info);
            Navigation.NavigateTo("/user/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao tentar deslogar.", Severity.Error);
            Logger.LogError(ex, "Erro no logout.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var localSettings = await JS.InvokeAsync<string>("localStorage.getItem", "adi_dark_mode");
            if (!string.IsNullOrEmpty(localSettings))
            {
                _isDarkMode = bool.Parse(localSettings);
                StateHasChanged();
            }
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("adiTheme.set", _isDarkMode);
    }

    public string DarkLightModeButtonIcon => _isDarkMode
        ? Icons.Material.Rounded.AutoMode
        : Icons.Material.Outlined.DarkMode;

    private async Task LoadAuthenticationStateAsync()
    {
        await DataSessionHelper.ClearAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var token = await _jwtAuthenticationService.GetTokenAsync();

        if (!string.IsNullOrEmpty(token))
        {
            await DataSessionHelper.LoadSession(token);
            var user1 = DataSessionHelper.DataSession;
            _fullName = user1.Name;
            _level = user1.Level;
            _environment = ((EnvironmentEnum?)user1.EnvironmentType).ToString();
            try { await FavoritosState.GarantirCarregadoAsync(); }
            catch (Exception ex) { Logger.LogWarning(ex, "Não foi possível pré-carregar os favoritos do usuário."); }
        }

        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated == true;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _fullName = user.Claims.FirstOrDefault(x => x.Type == "Name")?.Value ?? user.Identity?.Name;
        _level = user.Claims.FirstOrDefault(x => x.Type == "Level")?.Value;
        _environment = FormatEnvironment(user.Claims.FirstOrDefault(x => x.Type == "Environment")?.Value);

        if (_isAuthenticated && !IsLoginPage)
            await InicializarMonitorBiometriaAsync();
        else
            PararMonitorBiometria();

        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        if (IsLoginPage)
            PararMonitorBiometria();
        else if (_isAuthenticated)
            _ = InicializarMonitorBiometriaAsync();
        StateHasChanged();
    }

    private void PararMonitorBiometria()
    {
        var cancelamento = _notificacaoBiometriaCts;
        _notificacaoBiometriaCts = null;
        if (cancelamento is null) return;
        cancelamento.Cancel();
        cancelamento.Dispose();
    }

    private void UpdateCurrentPath()
    {
        _currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
    }

    private static string? FormatEnvironment(string? value)
    {
        return EnvironmentClaimFormatter.Format(value);
    }

    private static string NormalizarReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)) return "/main";

        var rota = returnUrl.Trim();
        if (!rota.StartsWith('/') || rota.StartsWith("//") || rota.StartsWith("/user/login", StringComparison.OrdinalIgnoreCase))
            return "/main";

        return rota;
    }

    public void Dispose()
    {
        PararMonitorBiometria();
        Navigation.LocationChanged -= OnLocationChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Loading.OnChange -= OnLoadingChanged;
        SessionExpirationState.SessionExpired -= OnSessionExpiredAsync;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Background = "#f7f8fa",
        Surface = "#ffffff",
        AppbarText = "#ffffff",
        DrawerBackground = "#ffffff",
        DrawerText = "#2b2b2b",
        DrawerIcon = "#6b7280",
        Divider = "#bfbfbf",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

    private string GetMainContentClass()
    {
        var uri = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLower();
        bool isHome = string.IsNullOrEmpty(uri) || uri == "/home" || uri == "/";

        if (ShowAppBar)
        {
            return isHome ? "pa-0" : "pt-12 pa-4";
        }

        return isHome ? "pa-0" : "pa-4";
    }
}
