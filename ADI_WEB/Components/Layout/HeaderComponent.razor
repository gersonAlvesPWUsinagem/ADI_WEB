@page "/exemplo-botoes"
@using Domain.Dtos.Permission
@inject ILoginService _loginService;
@inject ICurrentUser CurrentUser
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>@Title</PageTitle>

<MudGrid Class="align-center mb-9 mt-1">
    <MudItem xs="12" sm="6">
        <!-- Exibe Title2 se preenchido, caso contrário exibe Title -->
@*                 <h1>@(!string.IsNullOrEmpty(Title2) ? Title2 : Title)</h1>
 *@                <MudText Typo="Typo.h4" GutterBottom="true">@(!string.IsNullOrEmpty(Title2) ? Title2 : Title)</MudText>
    </MudItem>

    <MudSpacer />

    <AuthorizeView>
        <Authorized>
            <MudItem>
                <MudStack Row="true" Spacing="2" Class="d-flex justify-end align-center">
                    @foreach (var item in ListBtnDaTela)
                    {
                        @if (item.IsVisibleOrNot)
                    {
                        <MudTooltip Text="@item.Tooltip">
                            @if (item.IsFab)
                        {
                                <MudFab Color="@item.Color"
                                        StartIcon="@item.Icon"
                                        Disabled="@(Processing || item.IsDisabled)"
                                        Size="Size.Small"
                                    OnClick="@(() => ExecutarCliqueAsync(item))"
                                        Style="@item.IsVisibleOrNotCss" />
                            }
                            else
                            {
                                <MudButton Variant="@item.Variant"
                                           Disabled="@(Processing || item.IsLoading || item.IsDisabled)"
                                           Size="@item.Size"
                                           Color="@item.Color"
                                           StartIcon="@item.Icon"
                                           OnClick="@(() => ExecutarCliqueAsync(item))"
                                           Style="@item.IsVisibleOrNotCss">
                                    @if (Processing || item.IsLoading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        <span style="margin-left: 8px;">Carregando...</span>
                                    }
                                    else
                                    {
                                        <span>@item.Title</span>
                                    }
                                </MudButton>
                            }
                        </MudTooltip>
                        }
                    }
                </MudStack>
            </MudItem>
        </Authorized>
    </AuthorizeView>
</MudGrid>

@code {
    [Parameter] public string Title { get; set; } = "NONE";
    [Parameter] public string? Title2 { get; set; }

    [Parameter] public ModuloEnum? Modulo { get; set; }
    [Parameter] public int? Permission { get; set; }

    [Parameter] public string TextBtn1 { get; set; } = "None";
    [Parameter] public string TextBtn2 { get; set; } = "None";
    [Parameter] public string TextBtn3 { get; set; } = "None";
    [Parameter] public string TextBtn4 { get; set; } = "None";
    [Parameter] public string TextBtn5 { get; set; } = "None";
    [Parameter] public string? TooltipBtn1 { get; set; }
    [Parameter] public string? TooltipBtn2 { get; set; }
    [Parameter] public string? TooltipBtn3 { get; set; }
    [Parameter] public string? TooltipBtn4 { get; set; }
    [Parameter] public string? TooltipBtn5 { get; set; }

    [Parameter] public bool IsVisibleOrNotBtn1 { get; set; } = true;
    [Parameter] public bool IsVisibleOrNotBtn2 { get; set; } = true;
    [Parameter] public bool IsVisibleOrNotBtn3 { get; set; } = true;
    [Parameter] public bool IsVisibleOrNotBtn4 { get; set; } = true;
    [Parameter] public bool IsVisibleOrNotBtn5 { get; set; } = true;
    [Parameter] public bool IsDisabledBtn1 { get; set; }
    [Parameter] public bool IsDisabledBtn2 { get; set; }
    [Parameter] public bool IsDisabledBtn3 { get; set; }
    [Parameter] public bool IsDisabledBtn4 { get; set; }
    [Parameter] public bool IsDisabledBtn5 { get; set; }
    [Parameter] public bool Processing { get; set; }
    [Parameter] public bool IsLoadingBtn1 { get; set; }
    [Parameter] public bool IsLoadingBtn2 { get; set; }
    [Parameter] public bool IsLoadingBtn3 { get; set; }
    [Parameter] public bool IsLoadingBtn4 { get; set; }
    [Parameter] public bool IsLoadingBtn5 { get; set; }

    [Parameter] public bool MudFab1 { get; set; }
    [Parameter] public bool MudFab2 { get; set; }
    [Parameter] public bool MudFab3 { get; set; }
    [Parameter] public bool MudFab4 { get; set; }
    [Parameter] public bool MudFab5 { get; set; }

    [Parameter] public string IconBtn1 { get; set; } = string.Empty;
    [Parameter] public string IconBtn2 { get; set; } = string.Empty;
    [Parameter] public string IconBtn3 { get; set; } = string.Empty;
    [Parameter] public string IconBtn4 { get; set; } = string.Empty;
    [Parameter] public string IconBtn5 { get; set; } = string.Empty;

    [Parameter] public Color? ColorBtn1 { get; set; } = Color.Default;
    [Parameter] public Color? ColorBtn2 { get; set; } = Color.Default;
    [Parameter] public Color? ColorBtn3 { get; set; } = Color.Default;
    [Parameter] public Color? ColorBtn4 { get; set; } = Color.Default;
    [Parameter] public Color? ColorBtn5 { get; set; } = Color.Default;

    [Parameter] public int? LevelBtn1 { get; set; }
    [Parameter] public int? LevelBtn2 { get; set; }
    [Parameter] public int? LevelBtn3 { get; set; }
    [Parameter] public int? LevelBtn4 { get; set; }
    [Parameter] public int? LevelBtn5 { get; set; }

    [Parameter] public EventCallback OnBtn1Click { get; set; }
    [Parameter] public EventCallback OnBtn2Click { get; set; }
    [Parameter] public EventCallback OnBtn3Click { get; set; }
    [Parameter] public EventCallback OnBtn4Click { get; set; }
    [Parameter] public EventCallback OnBtn5Click { get; set; }

    private List<BtnLayout> ListBtnDaTela { get; } = new List<BtnLayout>();
    private List<PermissionUserDto>? PermissionUserList { get; set; }
    private bool _permissoesCarregadas = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarPermissoesEAtualizarBotoesAsync();
    }

    protected override void OnParametersSet()
    {
        AtualizarApenasEstadoDosBotoes();
    }

    private async Task CarregarPermissoesEAtualizarBotoesAsync()
    {
        var botoesCandidatos = CriarListaCandidatos();
        var IsDisabledValidate = botoesCandidatos.Any(b => b.Level.HasValue);

        if (IsDisabledValidate && !_permissoesCarregadas)
        {
            var data = await _loginService.ValidarPermissaoAsync(Modulo ?? 0, Permission ?? 0);

            if (data is not null && data.Success && data.Value is not null && data.Value.Count > 0)
            {
                PermissionUserList = data.Value;
                _permissoesCarregadas = true;
            }
        }

        AplicarRegrasDeNegocioNosBotoes(botoesCandidatos);

        ListBtnDaTela.Clear();
        ListBtnDaTela.AddRange(botoesCandidatos);
    }

    private void AtualizarApenasEstadoDosBotoes()
    {
        var botoesCandidatos = CriarListaCandidatos();
        AplicarRegrasDeNegocioNosBotoes(botoesCandidatos);

        ListBtnDaTela.Clear();
        ListBtnDaTela.AddRange(botoesCandidatos);
    }

    private async Task ExecutarCliqueAsync(BtnLayout item)
    {
        if (item.Level.HasValue && !TemPermissao(item.Level.Value))
        {
            _snackbarComp.Message(
                $"Você não tem permissão para executar esta tarefa. Módulo: {Modulo}. Permissão: {Permission}. Nível necessário: {item.Level}.",
                Severity.Error,
                Color.Error);
            return;
        }

        await item.OnClick.InvokeAsync();
    }

    private bool TemPermissao(int nivelNecessario)
    {
        // A consulta da API já é filtrada pelo módulo e pelo código da permissão.
        // Um nível maior sempre herda o acesso de todos os níveis menores.
        return PermissionUserList is not null &&
               PermissionLevelPolicy.Allows(
                   PermissionUserList.Select(x => x.Level),
                   nivelNecessario);
    }

    private List<BtnLayout> CriarListaCandidatos()
    {
        return new List<BtnLayout>
        {
            new BtnLayout { Tooltip = TooltipBtn1 ?? TextBtn1, IsDisabled = LevelBtn1.HasValue || IsDisabledBtn1, IsDisabledBase = IsDisabledBtn1, Title = TextBtn1, Icon = IconBtn1, Color = ColorBtn1 ?? Color.Primary, IsVisibleBase = IsVisibleOrNotBtn1, Level = LevelBtn1, IsFab = MudFab1, IsLoading = IsLoadingBtn1, OnClick = OnBtn1Click },
            new BtnLayout { Tooltip = TooltipBtn2 ?? TextBtn2, IsDisabled = LevelBtn2.HasValue || IsDisabledBtn2, IsDisabledBase = IsDisabledBtn2, Title = TextBtn2, Icon = IconBtn2, Color = ColorBtn2 ?? Color.Secondary, IsVisibleBase = IsVisibleOrNotBtn2, Level = LevelBtn2, IsFab = MudFab2, IsLoading = IsLoadingBtn2, OnClick = OnBtn2Click },
            new BtnLayout { Tooltip = TooltipBtn3 ?? TextBtn3, IsDisabled = LevelBtn3.HasValue || IsDisabledBtn3, IsDisabledBase = IsDisabledBtn3, Title = TextBtn3, Icon = IconBtn3, Color = ColorBtn3 ?? Color.Tertiary, IsVisibleBase = IsVisibleOrNotBtn3, Level = LevelBtn3, IsFab = MudFab3, IsLoading = IsLoadingBtn3, OnClick = OnBtn3Click },
            new BtnLayout { Tooltip = TooltipBtn4 ?? TextBtn4, IsDisabled = LevelBtn4.HasValue || IsDisabledBtn4, IsDisabledBase = IsDisabledBtn4, Title = TextBtn4, Icon = IconBtn4, Color = ColorBtn4 ?? Color.Tertiary, IsVisibleBase = IsVisibleOrNotBtn4, Level = LevelBtn4, IsFab = MudFab4, IsLoading = IsLoadingBtn4, OnClick = OnBtn4Click },
            new BtnLayout { Tooltip = TooltipBtn5 ?? TextBtn5, IsDisabled = LevelBtn5.HasValue || IsDisabledBtn5, IsDisabledBase = IsDisabledBtn5, Title = TextBtn5, Icon = IconBtn5, Color = ColorBtn5 ?? Color.Tertiary, IsVisibleBase = IsVisibleOrNotBtn5, Level = LevelBtn5, IsFab = MudFab5, IsLoading = IsLoadingBtn5, OnClick = OnBtn5Click }
        };
    }

    private void AplicarRegrasDeNegocioNosBotoes(List<BtnLayout> botoesCandidatos)
    {
        foreach (var item in botoesCandidatos)
        {
            var possuiTexto = !string.Equals(item.Title, "None", StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(item.Title);
            var possuiConteudoFab = item.IsFab && !string.IsNullOrWhiteSpace(item.Icon);

            item.IsVisibleOrNot = item.IsVisibleBase && (possuiTexto || possuiConteudoFab);
        }

        foreach (var item in botoesCandidatos)
        {
            if (!item.Level.HasValue) continue;

            bool temPermissao = TemPermissao(item.Level.Value);

            item.IsDisabled = item.IsDisabledBase || !temPermissao;
        }
    }

    public class BtnLayout
    {
        public string? Title { get; set; }
        public string? Tooltip { get; set; }
        public Color Color { get; set; } = Color.Default;
        public bool IsVisibleBase { get; set; } = true;
        public bool IsVisibleOrNot { get; set; } = true;
        public bool IsDisabled { get; set; } = false;
        public bool IsDisabledBase { get; set; }
        public Size Size { get; } = Size.Small;
        public Variant Variant { get; } = Variant.Filled;
        public string Icon { get; set; } = Icons.Material.Filled.AccessAlarm;
        public EventCallback OnClick { get; set; }
        public string IsVisibleOrNotCss => !IsVisibleOrNot ? "display: none;" : string.Empty;
        public int? Level { get; set; }
        public bool IsFab { get; set; }
        public bool IsLoading { get; set; }
    }
}
