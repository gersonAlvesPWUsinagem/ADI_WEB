@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject JwtAuthenticationService _jwtAuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataSessionHelper DataSessionHelper
@inject ILogger<NavMenu> Logger

<MudStack Spacing="2" Class="pa-3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
         <MudAvatar Color="Color.Primary" Size="Size.Medium">@Initials</MudAvatar>
        <MudStack Spacing="0">
             <MudText Typo="Typo.subtitle2">@FirstName</MudText>
           <MudText Typo="Typo.caption" Color="Color.Secondary">@SessionType</MudText> 
        </MudStack>
    </MudStack>
</MudStack>

@* <MudDivider /> *@
<MudNavMenu>
    <MudNavLink Href="/main" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Home">
        HOME
    </MudNavLink>

    <MudNavLink Href="/download-agent" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Download">
        DOWNLOADS
    </MudNavLink>

    <MudNavLink Href="/download-agent" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Phone">
        LISTA DE RAMAIS
    </MudNavLink>

    <MudNavGroup Title="TI" Icon="@Icons.Material.Filled.Computer" Expanded="false">
        <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Build">
            ......
        </MudNavLink>

        <MudNavLink Match="NavLinkMatch.Prefix" Href="glpi/termo-concessao" Icon="@Icons.Material.Filled.Description">
            GERADOR DE TERMO
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="RH" Icon="@Icons.Material.Filled.Groups" Expanded="false">
        <MudNavGroup Title="Portaria" Icon="@Icons.Material.Filled.Security" Expanded="false">
            <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login" Href="portaria/registrar-entrada-saida-colaborador">
               APT ENTRADA\SAÍDA
            </MudNavLink>
        </MudNavGroup>       
    </MudNavGroup>

    <MudNavLink Href="counter" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Calculate">
        Counter
    </MudNavLink>

    <MudNavLink Href="weather" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Cloud">
        Weather
    </MudNavLink>

    @*  <MudNavLink OnClick="EfetuarLogout" Icon="@Icons.Material.Filled.Logout">
        Sair
    </MudNavLink> *@
</MudNavMenu>

@code {
    private string? _fullName;
    private string? _level;
    private string? _environment;

    private string FirstName => string.IsNullOrWhiteSpace(_fullName)
        ? "Usuário"
        : _fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuário";

    private string Initials => FirstName.Length == 0 ? "U" : FirstName[..1].ToUpperInvariant();

    private string SessionType => string.Join(" / ", new[] { _level, _environment }.Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        SetUser();
        // SetUser(authState.User);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        //SetUser(authState.User);
        SetUser();
        await InvokeAsync(StateHasChanged);
    }

    private void SetUser(/*System.Security.Claims.ClaimsPrincipal user*/)
    {
        var user = DataSessionHelper.DataSession;
        _fullName = user.Name;
        _level = user.Level;
        _environment = ((EnvironmentEnum?)user.EnvironmentType ?? 0).GetDisplayName();  

        // _fullName = user.Claims.FirstOrDefault(x => x.Type == "Name")?.Value ?? user.Identity?.Name;
        // _level = user.Claims.FirstOrDefault(x => x.Type == "Level")?.Value;
        // _environment = FormatEnvironment(user.Claims.FirstOrDefault(x => x.Type == "Environment")?.Value);
    }

    private static string? FormatEnvironment(string? value)
    {
        return EnvironmentClaimFormatter.Format(value);
    }

    private async Task EfetuarLogout()
    {
        try
        {
            await _jwtAuthenticationService.LogoutAsync();

            Snackbar.Add("Sessão encerrada com sucesso.", Severity.Info);
            Navigation.NavigateTo("/user/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao tentar deslogar.", Severity.Error);
            Logger.LogError(ex, "Erro no logout.");
        }
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
