@using Domain.Dtos.Paginas
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject JwtAuthenticationService _jwtAuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDataSessionHelper DataSessionHelper
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<NavMenu> Logger
@inject IFavoritoPaginaService FavoritoService
@inject FavoritoPaginaState FavoritosState
@inject IPaginaCatalogoService PaginaCatalogoService

<MudStack Spacing="2" Class="pa-3 mt-12">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudAvatar Color="Color.Primary" Size="Size.Medium">@Initials</MudAvatar>
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle2">@FirstName</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@SessionType</MudText>
        </MudStack>
    </MudStack>
</MudStack>

@if (PaginaAtual is { Id: > 0 })
{
    <MudButton FullWidth="true" Variant="Variant.Text" Color="@(_favoritoAtual ? Color.Warning : Color.Default)"
               StartIcon="@(_favoritoAtual ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)"
               OnClick="AlternarFavoritoAsync" Disabled="_salvandoFavorito" Class="mb-2">
        @(_favoritoAtual ? "Remover favorito" : "Adicionar favorito")
    </MudButton>
}

<MudNavMenu>
    <NavMenuTree Menu="@Paginas" />
</MudNavMenu>

@code {
    private string? _fullName;
    private string? _level;
    private string? _environment;
    private bool _favoritoAtual;
    private bool _salvandoFavorito;
    private string _rotaAtual = string.Empty;

    // O menu acompanha visualmente esta estrutura. Para incluir uma página,
    // adicione-a no dicionário do grupo em que ela deve aparecer.
    public static readonly Dictionary<string, NavMenuItem> Paginas = new()
    {
        ["INÍCIO"] = NavMenuItem.Pagina(icone: Icons.Material.Filled.Home, rota: "/main", id: 1),
        ["DOWNLOADS"] = NavMenuItem.Pagina(icone: Icons.Material.Filled.Download, rota: "/downloads", catalogo: false, id: 3),
        ["RAMAIS"] = NavMenuItem.Pagina(icone: Icons.Material.Filled.ContactPhone, rota: "/ramais", id: 2),


        ["TI"] = NavMenuItem.Grupo(Icons.Material.Filled.Computer, new Dictionary<string, NavMenuItem>
        {
            ["PUBLICAR ARQUIVO"] = NavMenuItem.Pagina(Icons.Material.Filled.Upload, "/downloads/publicar", id: 3),
            ["GERADOR DE TERMO"] = NavMenuItem.Pagina(Icons.Material.Filled.Description, "/ti/termo/gerador", id: 4),
            ["CATÁLOGO DE PÁGINAS"] = NavMenuItem.Pagina(icone: Icons.Material.Filled.ErrorOutline, rota: "/ti/urls/catalogo-paginas", id: 8),
            ["LOGS DA API"] = NavMenuItem.Pagina(Icons.Material.Filled.ErrorOutline, "/ti/logs-api", id: 6)
        }),

        ["RH"] = NavMenuItem.Grupo(Icons.Material.Filled.Groups, new Dictionary<string, NavMenuItem>
        {
            ["PORTARIA"] = NavMenuItem.Grupo(Icons.Material.Filled.Security, new Dictionary<string, NavMenuItem>
            {
                ["APT. COLABORADORES"] = NavMenuItem.Pagina(Icons.Material.Filled.Login, "/recursos-humanos/portaria/apontamento/registrar-entrada-saida-colaborador", id: 7),
                ["CTR. VEÍCULOS"] = NavMenuItem.Pagina(Icons.Material.Filled.DirectionsCar, "/recursos-humanos/portaria/veiculo/controle-veiculo", id: 9),
                ["CTR. CRACHÁS"] = NavMenuItem.Pagina(Icons.Material.Filled.Badge, "/recursos-humanos/portaria/cracha/controle-cracha", id: 10),
                ["CTR. CHAVES"] = NavMenuItem.Pagina(Icons.Material.Filled.VpnKey, "/recursos-humanos/portaria/chave/controle-chave", id: 11),
                ["CTR. OPERADORES"] = NavMenuItem.Pagina(Icons.Material.Filled.ManageAccounts, "/recursos-humanos/portaria/operador/gerenciamento-operadores", id: 12),
                ["PESSOAS"] = NavMenuItem.Pagina(Icons.Material.Filled.Groups, "/recursos-humanos/portaria/apontamento/gerenciamento-pessoas", id: 13)
            }),
            ["CATRACA"] = NavMenuItem.Grupo(
                Icons.Material.Filled.Toll,
                new Dictionary<string, NavMenuItem>
                {
                    ["CRACHÁ"] = NavMenuItem.Pagina(Icons.Material.Filled.SyncAlt, "/recursos-humanos/catraca/cracha/integracao", id: 14),
                    ["BIOMETRIA"] = NavMenuItem.Pagina(Icons.Material.Filled.Fingerprint, "/recursos-humanos/catraca/biometria/controle-biometrias", id: 15)
                }
            )
        })
    };

    private sealed record PaginaMenuAtual(string Nome, string Icone, int? Id);

    private PaginaMenuAtual? PaginaAtual => EncontrarPagina(Paginas, _rotaAtual);

    private static PaginaMenuAtual? EncontrarPagina(IReadOnlyDictionary<string, NavMenuItem> menu, string rotaAtual)
    {
        foreach (var entrada in menu)
        {
            var nome = entrada.Key;
            var item = entrada.Value;

            if (item.EhGrupo)
            {
                var paginaFilha = EncontrarPagina(item.Filhos!, rotaAtual);
                if (paginaFilha is not null) return paginaFilha;
            }
            else if (string.Equals(item.Rota?.Trim('/'), rotaAtual, StringComparison.OrdinalIgnoreCase))
            {
                return new PaginaMenuAtual(nome, item.Icone, item.Id);
            }
        }

        return null;
    }

    public static NavMenuItem? ObterPaginaPorId(int id) => EncontrarPaginaPorId(Paginas, id);

    public static string? ObterNomePorId(int id) => EncontrarNomePorId(Paginas, id);

    private static string? EncontrarNomePorId(IReadOnlyDictionary<string, NavMenuItem> menu, int id)
    {
        foreach (var entrada in menu)
        {
            if (entrada.Value.EhGrupo)
            {
                var nomeFilho = EncontrarNomePorId(entrada.Value.Filhos!, id);
                if (nomeFilho is not null) return nomeFilho;
            }
            else if (entrada.Value.Id == id)
                return string.IsNullOrWhiteSpace(entrada.Value.Nome) ? entrada.Key : entrada.Value.Nome;
        }
        return null;
    }

    public static IReadOnlyList<PaginaCatalogoDto> ObterDefinicoes()
    {
        var resultado = new List<PaginaCatalogoDto>();
        ColetarDefinicoes(Paginas, resultado);
        return resultado;
    }

    private static void ColetarDefinicoes(IReadOnlyDictionary<string, NavMenuItem> menu, ICollection<PaginaCatalogoDto> resultado)
    {
        foreach (var entrada in menu)
        {
            var item = entrada.Value;
            if (!item.ParticipaCatalogo) continue;
            if (item.EhGrupo)
            {
                ColetarDefinicoes(item.Filhos!, resultado);
                continue;
            }

            resultado.Add(new PaginaCatalogoDto
            {
                Id = item.Id,
                Chave = item.Chave ?? item.Rota ?? string.Empty,
                Nome = string.IsNullOrWhiteSpace(item.Nome) ? entrada.Key : item.Nome,
                Rota = item.Rota ?? string.Empty,
                Icone = item.Icone,
                Modulo = item.Modulo,
                Permissao = item.Permissao
            });
        }
    }

    private static NavMenuItem? EncontrarPaginaPorId(IReadOnlyDictionary<string, NavMenuItem> menu, int id)
    {
        foreach (var item in menu.Values)
        {
            if (item.EhGrupo)
            {
                var filha = EncontrarPaginaPorId(item.Filhos!, id);
                if (filha is not null) return filha;
            }
            else if (item.Id == id)
            {
                return item;
            }
        }

        return null;
    }

    private static void AplicarCatalogo(IReadOnlyDictionary<string, NavMenuItem> menu, IReadOnlyList<PaginaCatalogoDto> catalogo)
    {
        foreach (var item in menu.Values)
        {
            if (item.EhGrupo)
            {
                AplicarCatalogo(item.Filhos!, catalogo);
                continue;
            }

            if (item.Id is int id)
            {
                var cadastro = catalogo.FirstOrDefault(x => x.Id == id);
                item.AplicarCatalogo(cadastro?.RotaBanco, cadastro?.IconeBanco);
            }
        }
    }

    private string FirstName => string.IsNullOrWhiteSpace(_fullName)
        ? "Usuário"
        : _fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuário";

    private string Initials => FirstName.Length == 0 ? "U" : FirstName[..1].ToUpperInvariant();

    private string SessionType => string.Join(" / ", new[] { _level, _environment }.Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        AtualizarRotaAtual();
        await LoadUserAsync();
        await CarregarCatalogoAsync();
        await CarregarEstadoFavoritoAsync();
    }

    private async Task CarregarCatalogoAsync()
    {
        try
        {
            var definicoes = ObterDefinicoes();
#if DEBUG
            var sincronizado = await PaginaCatalogoService.SincronizarDesenvolvimentoAsync(definicoes);
            var resultado = sincronizado.Success ? sincronizado : await PaginaCatalogoService.ListarAsync();
#else
            var resultado = await PaginaCatalogoService.ListarAsync();
#endif
            if (resultado.Success && resultado.Value is not null)
                AplicarCatalogo(Paginas, resultado.Value);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Não foi possível carregar alterações do catálogo de páginas.");
        }
    }

    private void AtualizarRotaAtual() => _rotaAtual = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');

    private async Task CarregarEstadoFavoritoAsync()
    {
        _favoritoAtual = false;
        if (PaginaAtual is null) return;

        try
        {
            await FavoritosState.GarantirCarregadoAsync();
            _favoritoAtual = PaginaAtual?.Id is int id && FavoritosState.Contem(id);
        }
        catch
        {
            _favoritoAtual = false;
        }
    }

    private async Task AlternarFavoritoAsync()
    {
        var pagina = PaginaAtual;
        if (pagina?.Id is not int paginaUrlId) return;

        _salvandoFavorito = true;
        try
        {
            var favorito = new FavoritoPaginaDto
            {
                PaginaUrlId = paginaUrlId
            };
            var resultado = await FavoritoService.AlternarAsync(favorito);

            if (resultado.Success)
            {
                FavoritosState.Alternar(resultado.Value ?? favorito);
                _favoritoAtual = !_favoritoAtual;
                Snackbar.Add(resultado.Message ?? "Favoritos atualizados.", Severity.Success);
            }
            else
            {
                Snackbar.Add(resultado.Message ?? "Não foi possível atualizar os favoritos.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao atualizar favorito: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvandoFavorito = false;
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        AtualizarRotaAtual();
        await CarregarEstadoFavoritoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUserAsync()
    {
        await AuthenticationStateProvider.GetAuthenticationStateAsync();
        SetUser();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await task;
        SetUser();
        await InvokeAsync(StateHasChanged);
    }

    private void SetUser()
    {
        var user = DataSessionHelper.DataSession;
        if (user != null)
        {
            _fullName = user.Name;
            _level = user.Level;
            _environment = ((EnvironmentEnum?)user.EnvironmentType ?? 0).GetDisplayName();
        }
    }

    private async Task EfetuarLogout()
    {
        try
        {
            await _jwtAuthenticationService.LogoutAsync();
            Snackbar.Add("Sessão encerrada com sucesso.", Severity.Info);
            Navigation.NavigateTo("/user/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro ao tentar deslogar.", Severity.Error);
            Logger.LogError(ex, "Erro no logout.");
        }
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
