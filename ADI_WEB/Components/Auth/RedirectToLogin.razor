@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject JwtAuthenticationService JwtAuthenticationService

@if (_isAuthenticated)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
        Acesso negado para o seu perfil.
    </MudAlert>
}
else if (_exibirMensagemSessaoExpirada)
{
    <MudMessageBox @bind-Visible="_exibirMensagemSessaoExpirada"
                   Title="Sessão expirada"
                   Message="Sua sessão expirou. Entre novamente para continuar de onde parou.">
        <YesButton>
            <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="IrParaLoginAsync">
                Ir para o login
            </MudButton>
        </YesButton>
    </MudMessageBox>
}

@code {
    [Parameter] public string LoginPath { get; set; } = "/user/login";

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _isAuthenticated;
    private bool _exibirMensagemSessaoExpirada;
    private string _returnUrl = string.Empty;
    private bool _redirectChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _redirectChecked || AuthenticationStateTask is null)
        {
            return;
        }

        try
        {
            var authState = await AuthenticationStateTask;
            _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
            _returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            _redirectChecked = true;

            if (!_isAuthenticated)
            {
                if (JwtAuthenticationService.ConsumirTokenExpirado())
                {
                    _exibirMensagemSessaoExpirada = true;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                Navigation.NavigateTo($"{LoginPath}?returnUrl={Uri.EscapeDataString(_returnUrl)}", replace: true);
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception)
        {
            _redirectChecked = true;
            Navigation.NavigateTo(LoginPath, replace: true);
        }
    }

    private Task IrParaLoginAsync()
    {
        _exibirMensagemSessaoExpirada = false;
        Navigation.NavigateTo($"{LoginPath}?returnUrl={Uri.EscapeDataString(_returnUrl)}", replace: true);
        return Task.CompletedTask;
    }
}
