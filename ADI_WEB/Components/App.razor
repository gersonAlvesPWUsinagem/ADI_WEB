<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    <ImportMap />
@*     <link rel="icon" type="image/ico" href="favicon.ico" />
 *@   
        <link rel="icon" type="image/png" href="ico_adi_2025.png" />
    <script>
        (() => {
            try {
                const savedTheme = localStorage.getItem('adi_dark_mode');
                if (savedTheme === 'true' || savedTheme === 'false') {
                    document.cookie = `adi_dark_mode=${savedTheme};path=/;max-age=31536000;SameSite=Lax`;
                    document.documentElement.dataset.adiDarkMode = savedTheme;
                }
            } catch { }

            window.adiTheme = {
                set: isDarkMode => {
                    const value = isDarkMode ? 'true' : 'false';
                    localStorage.setItem('adi_dark_mode', value);
                    document.cookie = `adi_dark_mode=${value};path=/;max-age=31536000;SameSite=Lax`;
                    document.documentElement.dataset.adiDarkMode = value;
                }
            };
        })();
    </script>
    <style>
        html[data-adi-dark-mode="true"],
        html[data-adi-dark-mode="true"] body {
            background-color: #1a1a27;
            color-scheme: dark;
            --mud-palette-background: #1a1a27;
            --mud-palette-background-gray: #151521;
            --mud-palette-surface: #1e1e2d;
            --mud-palette-appbar-background: rgba(26, 26, 39, 0.8);
            --mud-palette-appbar-text: #92929f;
            --mud-palette-drawer-background: #1a1a27;
            --mud-palette-drawer-text: #92929f;
            --mud-palette-drawer-icon: #92929f;
            --mud-palette-text-primary: #b2b0bf;
            --mud-palette-text-secondary: #92929f;
            --mud-palette-divider: #292838;
            --mud-palette-lines-default: #33323e;
            --mud-palette-skeleton: #2a2833;
        }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
    <script src="js/agente.js"></script>
    <script src="js/files.js"></script>

