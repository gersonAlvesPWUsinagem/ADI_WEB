@page "/user/login"
@attribute [AllowAnonymous]

@using ADI_WEB.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@using System.Reflection

@inject NavigationManager Navigation
@inject ILoginService _loginService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject JwtAuthenticationService _jwtAuthenticationService
@inject ILogger<LoginPage> Logger
@rendermode InteractiveServer

@layout LoginLayout
<PageTitle>Login - ADI</PageTitle>

<RedirectIfAuthenticated />

@if (_isProcessing)
{
    <MudProgressLinear Color="Color.Primary"
                       Indeterminate="true"
                       Size="Size.Small"
                       Style="position: absolute; top: 0; left: 0; right: 0; z-index: 2000; height: 4px;" />
}

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />

<NavBarLoginComp @bind-CurrentSession="_currentSession" />

@* Ajustado para ocupar o espaço disponível de forma flexível e segura no mobile *@
<MudLayout Style="min-height: calc(100vh - 60px); width: 100%; display: flex; flex-direction: column; position: relative; overflow-y: auto; padding: 16px;">

    @* Alinhamento centralizado do formulário com espaçamento superior limpo para não sobrepor a navbar *@
    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="flex-grow-1" Style="width: 100%; padding-top: 16px;">
        <MudContainer MaxWidth="MaxWidth.Small" Style="max-width: 330px; padding: 0;">
            <EditForm Model="@_loginModel" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />

                @* Bloco centralizado da Logo *@
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mb-6" Style="width: 100%;">
                    <MudAvatar Style="height: 80px; width: 90px; background-color: #ffffff; border-radius: 12px; padding: 8px; box-shadow: 0px 4px 12px rgba(0,0,0,0.15);"
                               Variant="Variant.Filled">
                        <MudImage Src="../imagens/pwusinagem_transparente.png"
                                  Alt="Logo PW Usinagem"
                                  Style="width: 100%; height: 100%; object-fit: contain;" />
                    </MudAvatar>
                </MudStack>

                <MudTextField T="string"
                              Label="Usuário"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              Style="height:50px"
                              @bind-Value="_loginModel!.Username"
                              For="@(() => _loginModel!.Username)"
                              FullWidth="true" />

                <MudTextField T="string"
                              Label="Senha"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-5"
                              InputType="@PasswordInput"
                              @bind-Value="_loginModel!.Password"
                              For="@(() => _loginModel!.Password)"
                              IconSize="Size.Small"
                              Style="height:50px"
                              Adornment="Adornment.End"
                              AdornmentIcon="@PasswordInputIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Show Password"
                              FullWidth="true" />

                <MudButton ButtonType="ButtonType.Submit"
                           Class="adi-desktop-only"
                           Disabled="@_isProcessing"
                           FullWidth="true"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Style="height: 50px;">
                    @if (_isProcessing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span style="margin-left: 8px;">Carregando...</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </MudButton>
                <button type="submit"
                        class="adi-mobile-only adi-native-button adi-mobile-login-submit"
                        disabled="@_isProcessing">
                    @(_isProcessing ? "Carregando..." : "Login")
                </button>
            </EditForm>
        </MudContainer>
    </MudStack>

    @* Rodapé fixo ou flexível na parte inferior *@
    <div style="text-align: center; padding: 16px 0; margin-top: auto;">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            © 2025 ADI v @_loginModel.Version
        </MudText>
    </div>

</MudLayout>

@code {
    private LoginDto _loginModel = new();
    private bool _isProcessing = false;
    private string? _errorMessage = null;
    private bool _isShowPassword = false;
    private bool _open;
    private bool _fixed;

    private DefSessionDtos _currentSession = new();

    private bool _isDarkMode = false;
    private MudTheme? _theme = null;

    private const string LocalStorageKey = "adi_session_directives";

    [Inject]
    public IHttpContextAccessor HttpAccessor { get; set; } = default!;

    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private Func<EnvironmentEnum, string> convertFunc = ci =>
        $"{ci.GetDisplayName()} {ci.GetDisplayDescription() ?? ""}".Trim();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };

        var assembly = Assembly.GetExecutingAssembly();
        var versao = assembly.GetName().Version;

        if (versao != null)
        {
            _loginModel.Version = $"{versao.Major}.{versao.Minor}.{versao.Build}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var localSettings = await JS.InvokeAsync<string>("localStorage.getItem", "adi_dark_mode");
            if (!string.IsNullOrEmpty(localSettings))
            {
                _isDarkMode = bool.Parse(localSettings);
            }

            try
            {
                var jsonSaved = await JS.InvokeAsync<string?>("localStorage.getItem", LocalStorageKey);
                if (!string.IsNullOrEmpty(jsonSaved))
                {
                    var dadosSalvos = System.Text.Json.JsonSerializer.Deserialize<DefSessionDtos>(jsonSaved);
                    if (dadosSalvos != null)
                    {
                        _currentSession = dadosSalvos;
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Erro ao recuperar diretivas de sessao na Login.");
            }

            StateHasChanged();
        }
    }

    private void TogglePasswordVisibility()
    {
        if (_isShowPassword)
        {
            _isShowPassword = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            _isShowPassword = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }

    private async Task OnValidSubmit(EditContext context)
    {
        if (!SessaoPossuiContextoObrigatorio())
        {
            Snackbar.Add("Configure o código da empresa, filial e estabelecimento antes de entrar.", Severity.Warning);
            await AbrirConfiguracaoSessaoComTutorialAsync();
            return;
        }

        _isProcessing = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            TargetOSTypeEnum navegadorDetectado = ObterNomeNavegador();
            var user = new UserDto
            {
                Username = _loginModel.Username,
                Password = _loginModel.Password,
                TargetOSType = navegadorDetectado,
                Android = _currentSession.Patrimonio,
                Empresa = _currentSession.Empresa ?? 0,
                Estabelecineto = _currentSession.Estabelecimento ?? 0,
                Filial = _currentSession.Filial ?? 0,
                IpV4 = _currentSession.IPV4,
                Environment = _currentSession.Environment,
                MacAddress = _currentSession.MacAddress,
                Version = _loginModel.Version
            };

            var resultado = await _loginService.FazerLoginAsync(user);

            if (resultado != null && resultado.Success)
            {
                string tokenValido = resultado.Value ?? throw new Exception("Value retornou null");

                if (!string.IsNullOrEmpty(tokenValido))
                {
                    using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(10));
                    await _jwtAuthenticationService.LoginAsync(tokenValido).WaitAsync(timeout.Token);

                    Snackbar.Add($"Bem-vindo, {_loginModel.Username}! Login efetuado com sucesso.", Severity.Success);

                    var destino = ObterDestinoPosLogin();
                    Navigation.NavigateTo(destino, replace: true);
                }
                else
                {
                    Snackbar.Add("A API autenticou, mas não retornou um token válido.", Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add(ObterMensagemFalhaLogin(resultado?.StatusCode, resultado?.Message), Severity.Error);
            }
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("A sessão não pôde ser concluída em tempo hábil. Verifique o HTTPS e tente novamente.", Severity.Error);
            Logger.LogWarning("Timeout ao gravar ou validar o cookie de autenticação.");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Não foi possível processar o login no momento. Tente novamente.", Severity.Error);
            Logger.LogError(ex, "Erro critico na pagina de login.");
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private bool SessaoPossuiContextoObrigatorio() =>
        _currentSession.Empresa is > 0 &&
        _currentSession.Filial is > 0 &&
        _currentSession.Estabelecimento is > 0;

    private async Task AbrirConfiguracaoSessaoComTutorialAsync()
    {
        var parameters = new DialogParameters<DefinicoesDialog>
        {
            { x => x.SessionModel, _currentSession },
            { x => x.ModoExplicativo, false }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DefinicoesDialog>("Configurar acesso da empresa", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is DefSessionDtos dadosAtualizados)
        {
            _currentSession = dadosAtualizados;
            await JS.InvokeVoidAsync("localStorage.setItem", LocalStorageKey,
                System.Text.Json.JsonSerializer.Serialize(_currentSession));
            Snackbar.Add("Configuração salva. Tente entrar novamente.", Severity.Success);
        }
    }

    private static string ObterMensagemFalhaLogin(int? statusCode, string? mensagem)
    {
        if (statusCode == 601)
        {
            return "Usuário ou senha incorretos. Verifique as credenciais e tente novamente.";
        }

        return string.IsNullOrWhiteSpace(mensagem)
            ? "Não foi possível validar o login no momento. Tente novamente."
            : mensagem;
    }

    private string ObterDestinoPosLogin()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        var destino = query.TryGetValue("returnUrl", out var returnUrl)
            ? returnUrl.ToString()
            : string.Empty;

        if (!string.IsNullOrWhiteSpace(destino) &&
            destino.StartsWith('/') &&
            !destino.StartsWith("//") &&
            !destino.StartsWith("/user/login", StringComparison.OrdinalIgnoreCase))
        {
            return destino;
        }

        return "/main";
    }

    private TargetOSTypeEnum ObterNomeNavegador()
    {
        try
        {
            var context = HttpAccessor?.HttpContext;

            if (context?.Request?.Headers != null &&
                context.Request.Headers.TryGetValue("User-Agent", out var userAgentValues))
            {
                string userAgent = userAgentValues.ToString();
                if (string.IsNullOrEmpty(userAgent)) return TargetOSTypeEnum.Unknown;

                string uaLower = userAgent.ToLower();

                if (uaLower.Contains("edg/") || uaLower.Contains("edge")) return TargetOSTypeEnum.Edge;
                if (uaLower.Contains("opera") || uaLower.Contains("opr/")) return TargetOSTypeEnum.Opera;
                if (uaLower.Contains("chrome")) return TargetOSTypeEnum.Chrome;
                if (uaLower.Contains("firefox")) return TargetOSTypeEnum.Firefox;
                if (uaLower.Contains("safari")) return TargetOSTypeEnum.Safari;
            }

            return TargetOSTypeEnum.Unknown;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Erro ao processar User-Agent.");
            return TargetOSTypeEnum.Unknown;
        }
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Background = "#f5f5f5",
        Surface = "#ffffff",
        AppbarText = "#ffffff",
        DrawerBackground = "#ffffff",
        DrawerText = "#2b2b2b",
        DrawerIcon = "#6b7280",
        Divider = "#bfbfbf",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };
}
