@attribute [Authorize]
@page "/ramais"
@using ADI_WEB.Components.Layout

<PageTitle>Lista de Ramais</PageTitle>

<HeaderComponent Title="Lista de Ramais"
                 TextBtn1="Atualizar"
                 IconBtn1="@Icons.Material.Filled.Refresh"
                 ColorBtn1="Color.Primary"
                 IsVisibleOrNotBtn1="true"
                 OnBtn1Click="CarregarAsync"
                 TextBtn2="Exportar"
                 IconBtn2="@Icons.Material.Filled.Download"
                 ColorBtn2="Color.Secondary"
                 IsVisibleOrNotBtn2="true"
                 OnBtn2Click="AbrirRelatorioAsync" />

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4">
            <div class="d-flex align-center justify-space-between w-100">
                <MudText Typo="Typo.body1">Vínculos</MudText>
                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_ramais.Count</MudChip>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4">
            <div class="d-flex align-center justify-space-between w-100">
                <MudText Typo="Typo.body1">Ramais</MudText>
                <MudChip T="string" Color="Color.Success" Size="Size.Small">@TotalRamais</MudChip>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4">
            <div class="d-flex align-center justify-space-between w-100">
                <MudText Typo="Typo.body1">Setores</MudText>
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">@TotalSetores</MudChip>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-4" Elevation="1">
    <MudTextField @bind-Value="_filtro" Label="Pesquisar contato"
                  Placeholder="Nome, ramal, setor, telefone ou e-mail"
                  Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" />

    <MudDataGrid Items="RamaisFiltrados" Hover="true" Dense="true" Loading="_carregando" Bordered="_exibirBordas">
        <Columns>
            <PropertyColumn Property="x => x.Nome" Title="NOME" />
            <PropertyColumn Property="x => x.Matricula" Title="MATRÍCULA" />
            <PropertyColumn Property="x => x.Ramal" Title="RAMAL" />
            <PropertyColumn Property="x => x.Ddr" Title="DDR" />
            <PropertyColumn Property="x => x.Celular" Title="CELULAR" />
            <PropertyColumn Property="x => x.Setor" Title="SETOR" />
            <PropertyColumn Property="x => x.Email" Title="E-MAIL" />
        </Columns>
        <PagerContent>
            <div class="d-flex align-center justify-space-between mt-2 px-2">
                <MudSwitch @bind-Value="_exibirBordas" Label="Exibir bordas na tabela" Color="Color.Primary" Size="Size.Small" />
                <MudDataGridPager T="RamalDto" />
            </div>
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    [Inject] private IRamalService RamalService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private List<RamalDto> _ramais = [];
    private string? _filtro;
    private bool _carregando;
    private bool _exibirBordas;
    private int TotalSetores => _ramais.Where(x => !string.IsNullOrWhiteSpace(x.Setor)).Select(x => x.Setor).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private int TotalRamais => _ramais.Select(x => x.RamalId).Distinct().Count();

    private IEnumerable<RamalDto> RamaisFiltrados => string.IsNullOrWhiteSpace(_filtro) ? _ramais : _ramais.Where(x =>
        Contem(x.Nome) || Contem(x.Matricula.ToString()) || Contem(x.Ramal) || Contem(x.Ddr) || Contem(x.Celular) || Contem(x.Setor) || Contem(x.Email));
    private bool Contem(string? valor) => valor?.Contains(_filtro!, StringComparison.OrdinalIgnoreCase) ?? false;

    protected override Task OnInitializedAsync() => CarregarAsync();
    private async Task CarregarAsync()
    {
        Loading.Show(); _carregando = true;
        try
        {
            var result = await RamalService.ListarAsync();
            if (result.Success) _ramais = result.Value ?? [];
            else _snackbarComp.Message(result.Message ?? "Não foi possível carregar os ramais.", Severity.Error, Color.Error);
        }
        finally { _carregando = false; Loading.Hide(); }
    }

    private async Task AbrirRelatorioAsync()
    {
        var dialog = await DialogService.ShowAsync<RelatorioRamaisDialog>("Lista de Ramais",
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.ExtraSmall });
        var escolha = await dialog.Result;
        if (escolha is null || escolha.Canceled || escolha.Data is not string formato) return;

        Loading.Show();
        try
        {
            var resultado = await RamalService.GerarRelatorioAsync(formato);
            if (!resultado.Success || resultado.Value.Conteudo is null || resultado.Value.Conteudo.Length == 0)
            {
                _snackbarComp.Message(resultado.Message ?? "Não foi possível gerar a lista de ramais.", Severity.Error, Color.Error);
                return;
            }
            var arquivo = resultado.Value;
            await JS.InvokeVoidAsync("downloadOrOpenPdf", Convert.ToBase64String(arquivo.Conteudo), arquivo.MimeType, arquivo.NomeArquivo, formato == "PDF");
            _snackbarComp.Message("Lista de ramais gerada com sucesso.", Severity.Success, Color.Success);
        }
        catch (Exception ex) { _snackbarComp.Message($"Erro ao gerar relatório: {ex.Message}", Severity.Error, Color.Error); }
        finally { Loading.Hide(); }
    }
}
