@attribute [Authorize]
@page "/ramais"
@using ADI_WEB.Components.Layout

<PageTitle>Gerenciamento de Ramais</PageTitle>

<HeaderComponent Title="Ramais" Modulo="ModuloEnum.Comercial" Permission="113"
                 TextBtn1="Atualizar"
                 IconBtn1="@Icons.Material.Filled.Refresh"
                 ColorBtn1="Color.Primary"
                 LevelBtn1="0"
                 OnBtn1Click="CarregarAsync"

                 TextBtn2="Gerar lista de Ramais"
                 IconBtn2="@Icons.Material.Filled.Assessment"
                 ColorBtn2="Color.Secondary"
                 LevelBtn2="0"
                 OnBtn2Click="AbrirRelatorioAsync"

                 TextBtn3="@TextoAcaoEdicao"
                 IconBtn3="@IconeAcaoEdicao"
                 ColorBtn3="@CorAcaoEdicao"
                 LevelBtn3="3"
                 OnBtn3Click="AbrirInsercaoOuAlteracaoAsync"

                 TextBtn4="Excluir"
                 IconBtn4="@Icons.Material.Filled.Delete"
                 ColorBtn4="Color.Error"
                 LevelBtn4="4"
                 IsVisibleOrNotBtn4="@(_selecionado is not null)"
                 OnBtn4Click="ExcluirSelecionadoAsync"

                 
                 Processing="_carregando || _salvando" />

<MudPaper Class="pa-4 mt-2" Elevation="1">
    <MudTextField @bind-Value="_filtro"
                  Label="Pesquisar contato"
                  Placeholder="Nome, ramal, setor, telefone ou e-mail"
                  Immediate="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-4" />

    <MudDataGrid T="RamalDto"
                 Items="RamaisFiltrados"
                 Hover="true"
                 Dense="true"
                 Loading="_carregando"
                 Bordered="_exibirBordas"
                 RowClassFunc="ClasseDaLinha">
        <Columns>
            <TemplateColumn Title="EDITAR" Sortable="false" Filterable="false" CellClass="text-center">
                <CellTemplate>
                    <MudCheckBox T="bool"
                                 Value="@(RegistroSelecionado(context.Item))"
                                 ValueChanged="@(valor => SelecionarRegistro(context.Item, valor))"
                                 Color="Color.Warning"
                                 Size="Size.Small"
                                 Disabled="_salvando" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Nome" Title="NOME" />
@*             <PropertyColumn Property="x => x.Matricula" Title="MATRÍCULA" />
 *@            <PropertyColumn Property="x => x.Ramal" Title="RAMAL" />
            <PropertyColumn Property="x => x.Ddr" Title="DDR" />
            <PropertyColumn Property="x => x.Celular" Title="CELULAR" />
            <PropertyColumn Property="x => x.Setor" Title="SETOR" />
            <PropertyColumn Property="x => x.Email" Title="E-MAIL" />
        </Columns>
        <PagerContent>
            <div class="d-flex align-center justify-space-between mt-2 px-2">
                <MudSwitch @bind-Value="_exibirBordas"
                           Label="Exibir bordas na tabela"
                           Color="Color.Primary"
                           Size="Size.Small" />
                <MudDataGridPager T="RamalDto" />
            </div>
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    [Inject] private IRamalService RamalService { get; set; } = default!;

    private List<RamalDto> _ramais = [];
    private RamalDto? _selecionado;
    private string? _filtro;
    private bool _carregando;
    private bool _salvando;
    private bool _exibirBordas;

    private string TextoAcaoEdicao => _selecionado is null ? "Inserir" : "Alterar";
    private string IconeAcaoEdicao => _selecionado is null ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit;
    private Color CorAcaoEdicao => _selecionado is null ? Color.Success : Color.Warning;

    private IEnumerable<RamalDto> RamaisFiltrados => string.IsNullOrWhiteSpace(_filtro)
        ? _ramais
        : _ramais.Where(x => Contem(x.Nome)
            || Contem(x.Matricula.ToString())
            || Contem(x.Ramal)
            || Contem(x.Ddr)
            || Contem(x.Celular)
            || Contem(x.Setor)
            || Contem(x.Email));

    protected override Task OnInitializedAsync() => CarregarAsync();

    private bool Contem(string? valor) => valor?.Contains(_filtro!, StringComparison.OrdinalIgnoreCase) ?? false;

    private bool RegistroSelecionado(RamalDto registro) => _selecionado?.Id == registro.Id;

    private void SelecionarRegistro(RamalDto registro, bool selecionado)
    {
        _selecionado = selecionado ? registro : null;
    }

    private string ClasseDaLinha(RamalDto registro, int _) => RegistroSelecionado(registro) ? "ramal-selecionado" : string.Empty;

    private async Task CarregarAsync()
    {
        Loading.Show();
        _carregando = true;

        try
        {
            var resultado = await RamalService.ListarAsync();
            if (resultado.Success)
            {
                _ramais = resultado.Value ?? [];
                if (_selecionado is not null)
                    _selecionado = _ramais.FirstOrDefault(x => x.Id == _selecionado.Id);
            }
            else
            {
                _snackbarComp.Message(resultado.Message ?? "Não foi possível carregar os ramais.", Severity.Error, Color.Error);
            }
        }
        finally
        {
            _carregando = false;
            Loading.Hide();
        }
    }

    private async Task AbrirInsercaoOuAlteracaoAsync()
    {
        var titulo = _selecionado is null ? "Novo contato" : "Alterar contato";
        var parametros = new DialogParameters<RamalDialog>
        {
            { x => x.Modelo, CopiarModelo(_selecionado) }
        };

        var dialog = await DialogService.ShowAsync<RamalDialog>(titulo, parametros,
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large, BackdropClick = false });
        var resultado = await dialog.Result;

        if (resultado is null || resultado.Canceled || resultado.Data is not RamalDto modelo)
            return;

        await SalvarAsync(modelo);
    }

    private async Task SalvarAsync(RamalDto modelo)
    {
        _salvando = true;
        Loading.Show();

        try
        {
            var resultado = modelo.Id == 0
                ? await RamalService.AdicionarAsync(modelo)
                : await RamalService.AtualizarAsync(modelo);

            _snackbarComp.Message(resultado.Message ?? (resultado.Success ? "Operação concluída." : "Não foi possível salvar."),
                resultado.Success ? Severity.Success : Severity.Error,
                resultado.Success ? Color.Success : Color.Error);

            if (resultado.Success)
            {
                _selecionado = null;
                await CarregarAsync();
            }
        }
        finally
        {
            _salvando = false;
            Loading.Hide();
        }
    }

    private async Task ExcluirSelecionadoAsync()
    {
        if (_selecionado is null)
            return;

        var confirmar = await DialogService.ShowMessageBoxAsync("Excluir ramal",
            $"Deseja excluir {_selecionado.Nome} (ramal {_selecionado.Ramal})?",
            yesText: "Excluir", cancelText: "Cancelar");

        if (confirmar != true)
            return;

        _salvando = true;
        Loading.Show();

        try
        {
            var resultado = await RamalService.ExcluirAsync(_selecionado.Id);
            _snackbarComp.Message(resultado.Message ?? "Operação concluída.",
                resultado.Success ? Severity.Success : Severity.Error,
                resultado.Success ? Color.Success : Color.Error);

            if (resultado.Success)
            {
                _selecionado = null;
                await CarregarAsync();
            }
        }
        finally
        {
            _salvando = false;
            Loading.Hide();
        }
    }

    private async Task AbrirRelatorioAsync()
    {
        var dialog = await DialogService.ShowAsync<RelatorioRamaisDialog>("Lista de Ramais",
            new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.ExtraSmall });
        var escolha = await dialog.Result;

        if (escolha is null || escolha.Canceled || escolha.Data is not string formato)
            return;

        Loading.Show();
        try
        {
            var resultado = await RamalService.GerarRelatorioAsync(formato);
            if (!resultado.Success || resultado.Value.Conteudo is null || resultado.Value.Conteudo.Length == 0)
            {
                _snackbarComp.Message(resultado.Message ?? "Não foi possível gerar a lista de ramais.", Severity.Error, Color.Error);
                return;
            }

            var arquivo = resultado.Value;
            await JSRuntime.InvokeVoidAsync("downloadOrOpenPdf",
                Convert.ToBase64String(arquivo.Conteudo),
                arquivo.MimeType,
                arquivo.NomeArquivo,
                formato == "PDF");
            _snackbarComp.Message("Lista de ramais gerada com sucesso.", Severity.Success, Color.Success);
        }
        catch (Exception ex)
        {
            _snackbarComp.Message($"Erro ao gerar relatório: {ex.Message}", Severity.Error, Color.Error);
        }
        finally
        {
            Loading.Hide();
        }
    }

    private static RamalDto CopiarModelo(RamalDto? origem)
    {
        if (origem is null)
            return new RamalDto();

        return new RamalDto
        {
            Id = origem.Id,
            RamalId = origem.RamalId,
            EmpFil = origem.EmpFil,
            Matricula = origem.Matricula,
            PessoaId = origem.PessoaId,
            Nome = origem.Nome,
            Departamento = origem.Departamento,
            Ramal = origem.Ramal,
            Ddr = origem.Ddr,
            Celular = origem.Celular,
            Setor = origem.Setor,
            Email = origem.Email
        };
    }
}

<style>
    .ramal-selecionado > td {
        background-color: rgba(255, 152, 0, 0.12) !important;
    }
</style>
