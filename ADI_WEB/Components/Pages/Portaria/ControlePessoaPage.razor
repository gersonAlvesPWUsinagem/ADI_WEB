@attribute [Authorize]
@page "/portaria/registrar-entrada-saida-colaborador"
@using ADI_WEB.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@inject IDataSessionHelper DataSessionHelper
@inject IPortariaService _services
@inject AuthenticationStateProvider AuthenticationStateProvider
@* @inject PortariaControlePessoaViewModel _viewsModel *@

<HeaderComponent Title="Controle de Pesssoa"
                 TextBtn1="Encerrar o Dia (Gerar Apontamento)" IconBtn1=@Icons.Material.Filled.Approval 
                 IsVisibleOrNotBtn1=true ColorBtn1=@Color.Tertiary OnBtn1Click="GerarListaDeApontamentAsync" />

<MudItem xs="12" Class="mb-1">
    <div class="d-flex flex-wrap align-center gap-4">
        <MudChipSet T="int" Size="Size.Large"
                    SelectedValue="_mesSelecionado"
                    SelectedValueChanged="OnMesSelecionadoChanged"
                    CheckMark
                    SelectionMode="SelectionMode.SingleSelection"
                    Variant="Variant.Text" Color="Color.Info">
            <MudChip Value="13" Disabled="@(!(ElementsMemory != null && ElementsMemory.Count() > 0))">Todos</MudChip>
            @foreach (var mes in MesesAbreviados.Take(4))
            {
                <MudChip Value="@mes.Key">@mes.Value</MudChip>
            }

        </MudChipSet>
    </div>
</MudItem>

    @if (!_carregado)
    {
        <MudPaper Class="d-flex justify-cednter flex-grow-1 gap-4" Elevation="0">
            <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
        </MudPaper>
    }
    else
    {
    <MudDataGrid T="ControlePessoaDto"
                     MultiSelection="false"
                     Items="@(ElementsMemory is null || ElementsMemory.Count() == 0 ? Elements: ElementsMemory)"
                     SortMode="SortMode.Single"
                     Filterable="false"
                     QuickFilter="@_quickFilter"
                     Hideable="false"
                     RowClick="@RowClicked"
                     RowContextMenuClick="RowRightClicked"
                     SelectedItemsChanged="@SelectedItemsChanged"
                     Dense="true"
                     Striped="true"
                     Hover="true"

                     Bordered="@_bordered">

            <ToolBarContent>
                <MudText Typo="Typo.h6">Ref Dia: @(Elements?.OrderByDescending(x => x.ID).FirstOrDefault()?.DataOcorrencia ?? "Sem Data")</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Buscar por Nome, Matrícula ou C. Custo..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <Columns>
                <TemplateColumn Title="Ação">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Approval"
                                       Color="((string.IsNullOrEmpty(context.Item.HoraEntrada)) && (string.IsNullOrEmpty(context.Item.HoraSaida)) ? Color.Success :
                                                                                               (!string.IsNullOrEmpty(context.Item.HoraEntrada)) && (string.IsNullOrEmpty(context.Item.HoraSaida)) ? Color.Info : Color.Default)"
                                   OnClick="@(() => ApontarAsync(context.Item))"
                                   Disabled=@(!string.IsNullOrEmpty(context.Item.HoraEntrada) && !string.IsNullOrEmpty(context.Item.HoraSaida)) />
                </CellTemplate>
            </TemplateColumn>

                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudStack Row Justify="Justify.Center">
                        @if (!context.Item.OcorrenciaEntrada)
                            {
                                if (string.IsNullOrEmpty(context.Item.Ocorrencia))
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(!string.IsNullOrEmpty(context.Item.DataApEntrada) ? Color.Primary : Color.Default)">E</MudChip>
                                }
                                else
                                {
                                    <MudIcon Size="Size.Small" Class="mt-1" Color="Color.Warning"
                                             Icon="@Icons.Material.Filled.ReportGmailerrorred" Title="Registrado Ocorrência na Entrada" />
                                }
                            }
                            else
                            {
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.ReportGmailerrorred"
                                               aria-label="ocorrencia"
                                               Color=Color.Error
                                               OnClick="@(() => OcorrenciaAsync(context.Item))"
                                               Title="Registrar Ocorrência na Entrada" />
                            }
                            @if (!context.Item.OcorrenciaSaida)
                            {

                                if (!string.IsNullOrEmpty(context.Item.Ocorrencia) && (context.Item.DataApSaida ?? string.Empty).Length > 0)
                                {
                                    <MudIcon Size="Size.Small"
                                             Icon="@Icons.Material.Filled.ReportGmailerrorred" Title="Registrado Ocorrência na Entrada" />
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(!string.IsNullOrEmpty(context.Item.DataApSaida) ? Color.Primary : Color.Default)">S</MudChip>
                                }
                            }
                            else
                            {
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Filled.ReportGmailerrorred"
                                               aria-label="ocorrencia"
                                               Color=Color.Error
                                               OnClick="@(() => OcorrenciaAsync(context.Item))"
                                               Title="Registrar Ocorrência na Saída" />
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                    <PropertyColumn Property="x => x.NOME" Title="NOME">
                        <MudTooltip Text="Delete"/>
                    </PropertyColumn>


                <PropertyColumn Property="x => x.Operador1Display" Title="OPER (ENTR)" />
                <PropertyColumn Property="x => x.HoraEntrada" Title="HR ENTR" />
                <PropertyColumn Property="x => x.Operador2Display" Title="OPER (SAID)" />
                <PropertyColumn Property="x => x.HoraSaida" Title="HR SAID" />
                <PropertyColumn Property="x => x.DataOcorrencia" Title="DATA" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="ControlePessoa" />
            </PagerContent>

        </MudDataGrid>

        <MudGrid Class="d-flex justify-start flex-grow-1 gap-4" Spacing="11">
            <MudSwitch Class="ml-10" @bind-Value="_bordered" Color="Color.Warning">Exibir bordas na tabela</MudSwitch>
        </MudGrid>
    }


