    {
        var cultura = new CultureInfo("pt-BR");
        MesesAbreviados = Enumerable.Range(1, DateTime.Today.Month)
            .ToDictionary(mes => mes, mes => cultura.DateTimeFormat.GetAbbreviatedMonthName(mes).ToUpper());

        return Task.CompletedTask;
    }
    private void IrParaDiaAnterior()
    {
        var datasDisponiveis = Elements
            .Where(x => !string.IsNullOrEmpty(x.DataOcorrencia) && DateTime.TryParse(x.DataOcorrencia, out _))
            .Select(x => Convert.ToDateTime(x.DataOcorrencia).Date)
            .Distinct()
            .OrderBy(d => d)
            .ToList();

        var index = datasDisponiveis.IndexOf(_dataAtiva.Date);
        if (index > 0)
        {
            _dataAtiva = datasDisponiveis[index - 1];
            _mesSelecionado = _dataAtiva.Month;
            AtualizarFiltroMes();
        }
    }
    private void IrParaProximoDia()
    {
        var datasDisponiveis = Elements
            .Where(x => !string.IsNullOrEmpty(x.DataOcorrencia) && DateTime.TryParse(x.DataOcorrencia, out _))
            .Select(x => Convert.ToDateTime(x.DataOcorrencia).Date)
            .Distinct()
            .OrderBy(d => d)
            .ToList();

        var index = datasDisponiveis.IndexOf(_dataAtiva.Date);
        if (index >= 0 && index < datasDisponiveis.Count - 1)
        {
            _dataAtiva = datasDisponiveis[index + 1];
            _mesSelecionado = _dataAtiva.Month;
            AtualizarFiltroMes();
        }
    }
