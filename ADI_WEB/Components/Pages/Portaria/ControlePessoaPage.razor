    private IEnumerable<ControlePessoaDto> GetFilteredItems()
    {
        var query = ElementsMemory;

        // Se não estiver no modo "Todos" (13), filtra rigorosamente pelo dia ativo
        if (_mesSelecionado != 13)
        {
            query = query.Where(x => !string.IsNullOrEmpty(x.DataOcorrencia) &&
                                     DateTime.TryParse(x.DataOcorrencia, out var parsedDate) &&
                                     parsedDate.Date == _dataAtiva.Date);
        }

        // Aplica o filtro de status de movimentação se houver
        if (_filtroStatusMovimentacao == "SOMENTE_ENTRADA")
        {
            query = query.Where(x => !string.IsNullOrEmpty(x.HoraEntrada) && string.IsNullOrEmpty(x.HoraSaida));
        }
        else if (_filtroStatusMovimentacao == "SOMENTE_SAIDA")
        {
            query = query.Where(x => string.IsNullOrEmpty(x.HoraEntrada) && !string.IsNullOrEmpty(x.HoraSaida));
        }
        else if (_filtroStatusMovimentacao == "ENTRADA_SAIDA")
        {
            query = query.Where(x => !string.IsNullOrEmpty(x.HoraEntrada) && !string.IsNullOrEmpty(x.HoraSaida));
        }

        return query;
    }
    private async Task PesquisarPorDataDigitada()
    {
        var culturaBr = new CultureInfo("pt-BR");

        if (DateTime.TryParseExact(_dataTextoInput, new[] { "dd/MM/yyyy", "d/M/yyyy", "ddMMyyyy" }, culturaBr, System.Globalization.DateTimeStyles.None, out DateTime dataPesquisa))
        {
            _isFiltradoPorData = true;
            _dataAtiva = dataPesquisa.Date;
            _mesSelecionado = dataPesquisa.Month;

            bool existeNaLista = Elements.Any(x => !string.IsNullOrEmpty(x.DataOcorrencia) &&
                                                  DateTime.TryParse(x.DataOcorrencia, out var parsedDate) &&
                                                  parsedDate.Date == dataPesquisa.Date);

            if (existeNaLista)
            {
                AtualizarFiltroMes();
            }
            else
            {
                await CarregarListaDeControlados(dataPesquisa);
            }

            StateHasChanged();
        }
        else
        {
            _snackbarComp.Message("Formato de data inválido. Use DD/MM/AAAA.", Severity.Error, Color.Error);
        }
    }
    private async Task LimparFiltroDataAsync()
    {
        _isFiltradoPorData = false;
        _dataTextoInput = string.Empty;
        await CarregarListaDeControlados(null);
    }
    private bool PodeEditar(ControlePessoaDto colaborador)
    {
        if (colaborador == null || string.IsNullOrEmpty(colaborador.DataOcorrencia) || !DateTime.TryParse(colaborador.DataOcorrencia, out var dataOcorrencia))
            return false;

        var hoje = DateTime.Today;
        var ontem = hoje.AddDays(-1);

        bool dataValida = dataOcorrencia.Date == hoje || dataOcorrencia.Date == ontem;
        bool temMovimentacao = !string.IsNullOrEmpty(colaborador.HoraEntrada) || !string.IsNullOrEmpty(colaborador.HoraSaida);

        return dataValida && temMovimentacao;
    }
    private async Task AtualizarPaginaAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                //Loading.Show();
                _carregado = false;
                _somenteAtualizarGrid = true;
                try
                {
                    await CarregarListaDeControlados(_dataAtiva);

                    await PegarListaPorteiros();

                    StateHasChanged();
                }
                finally
                {
                    _carregado = true;
                    // Loading.Hide();
                    _somenteAtualizarGrid = false;
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _snackbarComp.Message(
                    $"Erro ao atualizar os apontamentos: {ex.Message}",
                    Severity.Error,
                    Color.Error);

                StateHasChanged();
            });
        }
    }
    private async Task CarregarAsync()
    {
        await CarregarListaDeControlados();
    }
