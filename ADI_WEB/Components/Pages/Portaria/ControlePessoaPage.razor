    private void OnMesSelecionadoChanged(int mes)
    {
        _mesSelecionado = mes;

        if (mes == 13)
        {
            ElementsMemory = null!;
        }

        // Filtrar os elementos pelo mês selecionado
        ElementsMemory = Elements
            .Where(x => !string.IsNullOrEmpty(x.DataOcorrencia))
            .Where(x =>
            {
                var dataObj = DateTime.ParseExact(x.DataOcorrencia!, "dd/MM/yyyy", CultureInfo.InvariantCulture);
                return dataObj.Month == mes;
            }).ToList();
        StateHasChanged();
    }

    private Task ContriMudChip()
    {
        MesesAbreviados = Elements
            .Where(x => !string.IsNullOrEmpty(x.DataOcorrencia))
            .Select(x =>
            {
                var dataObj = DateTime.ParseExact(x.DataOcorrencia!, "dd/MM/yyyy", CultureInfo.InvariantCulture);
                return new { NumeroMes = dataObj.Month, MesAbreviado = dataObj.ToString("MMM", new CultureInfo("pt-BR")).ToUpper() };
            })
            .DistinctBy(x => x.NumeroMes)
            .OrderBy(x => x.NumeroMes)
            .ToDictionary(x => x.NumeroMes, x => x.MesAbreviado);

        // Define o mês selecionado como o disponível mais próximo
        _mesSelecionado = EncontrarMesDisponivel();

        return Task.CompletedTask;
    }

    private int EncontrarMesDisponivel()
    {
        var mesAtual = DateTime.Now.Month;

        // Primeiro tenta o mês atual
        if (MesesAbreviados.ContainsKey(mesAtual))
            return mesAtual;

        // Se não encontrar, busca meses anteriores (até 6 meses para trás)
        for (int i = 1; i <= 6; i++)
        {
            var mesAnterior = mesAtual - i;
            if (mesAnterior < 1) mesAnterior += 12; // Volta para dezembro se passar de janeiro

            if (MesesAbreviados.ContainsKey(mesAnterior))
                return mesAnterior;
        }

        // Se não encontrar nenhum, retorna o primeiro mês disponível ou 0 (Todos)
        return MesesAbreviados.Keys.FirstOrDefault();
    }


