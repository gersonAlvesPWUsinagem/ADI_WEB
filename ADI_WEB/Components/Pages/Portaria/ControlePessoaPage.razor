    private async Task ExecutarAcaoMeiaNoite()
    {
        Console.WriteLine($"Executando ação da meia-noite em: {DateTime.Now}");
        await CarregarListaDeControlados();
        StateHasChanged();
    }

    private Func<ControlePessoaDto, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        // Melhora na busca para incluir NOME e Setor
        if (x.NOME!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.SetorName!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.TRADUCAO_CC!.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.MATRICULA!.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.DataOcorrencia!.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    protected override async Task OnInitializedAsync()
    {
        await CarregarListaDeControlados();
        //InicializarTimerMeiaNoite();

        var session = DataSessionHelper.DataSession;
        UserName = "Teste";
    }

    private async Task CarregarListaDeControlados()
    {
        try
        {
            var resultado = await _services
                .GetColaboradorControladoAsync();

            if (resultado.Success)
            {
                Elements = resultado.Value!
                    .ToList()
                    .OrderByDescending(dt => DateTime.ParseExact(dt.DataOcorrencia!, "dd/MM/yyyy", null))
                    .ToList();
                DataOcorrencia = Elements.FirstOrDefault()!.DataOcorrencia!;
            }
            await ContriMudChip();
            if (_mesSelecionado > 0)
            {
                OnMesSelecionadoChanged(_mesSelecionado);
            }
            else
            {
                ElementsMemory = Elements.ToList();
            }
            _carregado = true;
        }
        catch (Exception ex)
        {
            _snackbarComp.Message(ex.Message, Severity.Error, Color.Error);
            _carregado = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task<bool> DialogConfirm(ControlePessoaDto colaborador)
    {
        var parameters = new DialogParameters<DialogToggleAtivo>
        {
            {
                x => x.ContentText,
                // Mensagem UX ajustada
                string.IsNullOrEmpty(colaborador.HoraEntrada)
                    ? $"Confirma o registro da **ENTRADA** de **{colaborador.NOME}** agora?"
                    : $"Confirma o registro da **SAÍDA** de **{colaborador.NOME}** agora?"
            },
            {
                x => x.ButtonText,
                string.IsNullOrEmpty(colaborador.HoraEntrada) ? "CONFIRMAR ENTRADA" : "CONFIRMAR SAÍDA"
            },
            {
                x => x.Color,
                !string.IsNullOrEmpty(colaborador.HoraEntrada) ? Color.Warning : Color.Success
            },
        };

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        // Título do Diálogo ajustado (UX)
        var dialog = await DialogService.ShowAsync<DialogToggleAtivo>("Relógio de Ponto", parameters, options);

        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
            return true;
        return false;
    }

    private async Task ApontarAsync(ControlePessoaDto colaborador)
    {
        // Ação 'acao' não utilizada, removida para simplificar
        // var acao = string.IsNullOrEmpty(colaborador.HoraEntrada) ? "registrar a entrada" : "registrar a saída";

        var dialog = await DialogConfirm(colaborador);
        var typeEvent = 0;

        if (dialog)
        {
            if (string.IsNullOrEmpty(colaborador.HoraEntrada))
            {
                colaborador.Operador1 = UserName;
                colaborador.DataApEntrada = DateTime.Now.ToString("dd/MM/yyyy");
                typeEvent = 1;
            }

            else if (string.IsNullOrEmpty(colaborador.HoraSaida))
            {
                colaborador.Operador2 = UserName;
                colaborador.DataApSaida = DateTime.Now.ToString("dd/MM/yyyy");
                typeEvent = 2;
            }

            var data = new ApontarHrEntradaSaidaDto
            {
                Id = colaborador.ID,
                Nome = colaborador.NOME,
                PessoaId = colaborador.PessoaId,
                Operador1 = colaborador.Operador1,
                Operador2 = colaborador.Operador2,
                HoraEntrada = colaborador.HoraEntrada,
                HoraSaida = colaborador.HoraSaida,
                DataScEntrada = colaborador.DataScEntrada,
                DataScSaida = colaborador.DataScSaida,
                DataOcorrencia = colaborador.DataOcorrencia,
                TypeEvent = typeEvent
            };

            var result = await _services.PatchRegistrarHorasAsync(data);

            // Mensagem de Snackbar ajustada para ser mais informativa
            if (!result.Success)
            {
                _snackbarComp.Message($"Falha ao tentar registrar o ponto: {result.Message}", Severity.Error, Color.Error);
            }
            else
            {
                _snackbarComp.Message("Ponto registrado com sucesso!", Severity.Success, Color.Success);
            }

            if (!result.Success)
            {
                // Lógica para resetar campos em caso de erro mantida
                if (string.IsNullOrEmpty(colaborador.HoraEntrada))
                {
                    colaborador.Operador1 = null;
                    colaborador.OcorrenciaEntrada = true;
                    colaborador.OcorrenciaSaida = false;
                }
                else if (string.IsNullOrEmpty(colaborador.HoraSaida))
                {
                    colaborador.Operador2 = null;
                    colaborador.OcorrenciaSaida = true;
                    colaborador.OcorrenciaEntrada = false;
                }
                return;
            }

            if (result.Value is not null)
            {
                // Atualiza o item na lista com os dados do retorno (incluindo horas/operador)
                colaborador.HoraEntrada = result.Value.HoraEntrada;
                colaborador.HoraSaida = result.Value.HoraSaida;
                colaborador.Operador1 = result.Value.Operador1;
                colaborador.Operador2 = result.Value.Operador2;
            }
        }
        StateHasChanged();
    }

    private async Task GerarListaDeApontamentAsync()
    {
        var result = await _services.PostGerarListaDeApontamentAsync(UserName!);

        if (result is null || !result.Success)
        {
            _snackbarComp.Message($"Falha ao encerrar o dia: {result?.Message ?? "Erro desconhecido"}", Severity.Error, Color.Error);
            return;
        }
        _snackbarComp.Message("O dia de controle foi encerrado com sucesso! Os apontamentos foram gerados.", Severity.Success, Color.Success);
        await CarregarListaDeControlados();
    }

    private async Task OcorrenciaAsync(ControlePessoaDto colaborador)
    {

        DialogOptions options = new DialogOptions()
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        };

        var parameters = new DialogParameters<OcorrenciaDialog>
        {
            { x => x.Element, colaborador },
            { x => x.TypeOcorrencia, colaborador.OcorrenciaEntrada && !colaborador.OcorrenciaSaida },
            { x => x.Operador, UserName }
        };

        // Título do Diálogo ajustado (UX)
        var dialog = await DialogService.ShowAsync<OcorrenciaDialog>("Reportar Ocorrência de Ponto", parameters, options);

        var dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled)
        {
            var result = await _services.PatchRegistrarOcorrenciaAsync((PortariaOcorrenciaDto)dialogResult.Data!);

            // Mensagem de Snackbar ajustada
            if (!result.Success)
            {
                _snackbarComp.Message($"Falha ao registrar ocorrência: {result.Message}", Severity.Error, Color.Error);
            }
            else
            {
                _snackbarComp.Message("Ocorrência registrada com sucesso!", Severity.Success, Color.Success);
            }

            if (result.Value is not null)
            {
                colaborador.HoraEntrada = result.Value.HoraEntrada;
                colaborador.HoraSaida = result.Value.HoraSaida;
                colaborador.Operador1 = result.Value.Operador1;
                colaborador.Operador2 = result.Value.Operador2;
            }
        }
        StateHasChanged();
    }

