@using Domain.Dtos.ControleChaves
<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-4">Chave: <b>@Chave.Identificacao</b> — @Chave.Descricao</MudAlert>
        <SolicitanteChaveAutocomplete @bind-Value="_pessoa" />
        <MudTextField @bind-Value="_observacao" Label="Observação" Lines="3" MaxLength="500" Variant="Variant.Outlined" Class="mt-3" />
    </DialogContent>
    <DialogActions><MudButton OnClick="Cancelar">Cancelar</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Key" OnClick="Confirmar" Disabled="@(_pessoa is null || string.IsNullOrWhiteSpace(_pessoa.Nome))">Emprestar</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ControleChaveDto Chave { get; set; } = new();
    [Parameter] public int PorteiroId { get; set; }
    private PessoaChaveDto? _pessoa;
    private string? _observacao;
    private void Confirmar() => MudDialog.Close(DialogResult.Ok(new EmprestarChaveDto { EmpFil=_pessoa!.EmpFil, Matricula=_pessoa.Matricula, PessoaId=_pessoa.PessoaId, Nome=_pessoa.Nome, PorteiroId=PorteiroId, Observacao=_observacao }));
    private void Cancelar() => MudDialog.Cancel();
}
