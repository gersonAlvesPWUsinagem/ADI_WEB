@page "/downloads"
@using ADI_WEB.Components.Layout
@layout LoginLayout
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Downloads</PageTitle>

@if (_isProcessing)
{
    <MudProgressLinear Color="Color.Primary"
                       Indeterminate="true"
                       Size="Size.Small"
                       Style="position: absolute; top: 0; left: 0; right: 0; z-index: 2000; height: 4px;" />
}

@* Instanciação do componente compartilhado *@
<NavBarLoginComp />

@* Se o seu LoginLayout já não contiver um MudThemeProvider, você pode adicionar e amarrar a propriedade aqui *@
<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />

<MudLayout>
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">

        <MudText Typo="Typo.h4" GutterBottom="true">
            Downloads
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-6">
            Faça o download dos aplicativos e utilitários disponibilizados pela equipe de TI.
        </MudText>

        <MudGrid>
            @foreach (var item in DownloadsList)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="4" Style="height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@item.Icon" Size="Size.Large" Color="Color.Primary" />
                                    <MudText Typo="Typo.h6">@item.Nome</MudText>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>

                        <MudCardContent>
                            <MudText Typo="Typo.body2">@item.Descricao</MudText>
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.caption">
                                Versão: <b>@item.Versao</b>
                            </MudText>
                        </MudCardContent>

                        <MudCardActions>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       Href="@item.DownloadUrl"
                                       Target="_blank">
                                Download
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

    </MudContainer>
</MudLayout>

@code {
    private bool _isProcessing = false;
    private bool _isDarkMode = false;
    private MudTheme? _theme = null;
    private DefSessionDtos _currentSession = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    @* RESGATA A OPÇÃO SALVA NO LOCALSTORAGE ASSIM QUE A PÁGINA FOR RENDERIZADA *@
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var localSettings = await JS.InvokeAsync<string>("localStorage.getItem", "adi_dark_mode");
            if (!string.IsNullOrEmpty(localSettings))
            {
                _isDarkMode = bool.Parse(localSettings);
                StateHasChanged();
            }
        }
    }

    private readonly List<DownloadItem> DownloadsList = [
        new() {
            Nome = "Agente ADI x64",
            Descricao = "Assistente Local responsável pela integração entre o navegador e os recursos do computador.",
            Versao = "1.0.0",
            Icon = Icons.Material.Filled.Computer,
            DownloadUrl = "https://192.168.0.235:5260/downloads/AGENT_ADI/AgenteADI_Setup_x64.exe"
        },
        new() {
            Nome = "Agente ADI x86",
            Descricao = "Assistente Local responsável pela integração entre o navegador e os recursos do computador.",
            Versao = "1.0.0",
            Icon = Icons.Material.Filled.Computer,
            DownloadUrl = "https://192.168.0.235:5260/downloads/AGENT_ADI/AgenteADI_Setup_x86.exe"
        },
        new() {
            Nome = "Certificados de Segurança",
            Descricao = "Pacote contendo os certificados utilizados pelos sistemas internos.",
            Versao = "2026.1",
            Icon = Icons.Material.Filled.VerifiedUser,
            DownloadUrl = "https://192.168.0.235:5260/downloads/CERTIFICADOS/Certificados.zip"
        },
        new() {
            Nome = "Aplicativo do Coletor",
            Descricao = "Aplicativo Android utilizado nos coletores de dados.",
            Versao = "2.3.0",
            Icon = Icons.Material.Filled.Devices,
            DownloadUrl = "https://192.168.0.235:5260/downloads/COLETOR/Coletor.apk"
        }
    ];

    private readonly PaletteLight _lightPalette = new()
    {
        Background = "#f7f8fa",
        Surface = "#ffffff",
        AppbarText = "#ffffff",
        DrawerBackground = "#ffffff",
        DrawerText = "#2b2b2b",
        DrawerIcon = "#6b7280",
        Divider = "#bfbfbf",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

    private void AbrirAjuda(string tipo)
    {
        switch (tipo)
        {
            case "filial":
                Snackbar.Add("Instruções para configurar a filial: Acesse o menu X...", Severity.Info);
                break;
            case "maquina":
                Snackbar.Add("Para vincular sua máquina, baixe o agente ADI...", Severity.Info);
                break;
            case "credenciais":
                Snackbar.Add("Solicite suas credenciais ao RH ou gestor direto.", Severity.Info);
                break;
            case "senha":
                Navigation.NavigateTo("/recuperar-senha");
                break;
        }
    }
}