@page "/downloads"
@page "/download-agent"
@page "/downloads/COLETOR/{Version}"
@using ADI_WEB.Downloads
@using Microsoft.AspNetCore.Components.Authorization
@layout DownloadsLayout
@inject DownloadStorage Storage
@rendermode InteractiveServer

    <HeaderComponent Title="Downloads" />
<AuthorizeView>
            <NotAuthorized>
                <NavBarLoginComp />
            </NotAuthorized>
        </AuthorizeView>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-8">

            @*     <HeaderComponent Title="@Title" Modulo="ModuloEnum.Comercial" Permission="114"
                     TextBtn1="Publicar arquivo"
                     IconBtn1="@Icons.Material.Filled.Upload"
                     ColorBtn1="@Color.Primary"
                     LevelBtn1="2"
                     OnBtn1Click="Downloads" /> *@
@*             <HeaderComponent Title="@Title" Modulo="ModuloEnum.Comercial" Permission="114" />
 *@
            @if (!string.IsNullOrEmpty(CurrentDirectory))
            {
                <MudButton Href="@ParentUrl" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-4 adi-desktop-only">Voltar</MudButton>
                <a href="@ParentUrl" class="adi-mobile-only adi-native-button mb-4">Voltar</a>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Warning">@_error</MudAlert>
            }
            else if (_entries.Count == 0)
            {
                <MudAlert Severity="Severity.Info">Nenhum arquivo disponível nesta pasta.</MudAlert>
            }
            else
            {
                <MudGrid>
                    @foreach (var entry in _entries)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-4" Elevation="2">
                                <MudIcon Icon="@(entry.IsDirectory? Icons.Material.Filled.Folder : Icons.Material.Filled.InsertDriveFile)" Color="Color.Primary" />
                                <MudText Typo="Typo.h6" Style="overflow-wrap:anywhere">@entry.Name</MudText>
                                @if (!entry.IsDirectory)
                                {
                                    <MudText Typo="Typo.caption">@((entry.Size / 1024d / 1024d).ToString("N2")) MB</MudText>
                                }
                                <MudButton Href="@EntryUrl(entry)" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3 adi-desktop-only">
                                    @(entry.IsDirectory ? "Abrir pasta" : "Baixar arquivo")
                                </MudButton>
                                <a href="@EntryUrl(entry)" class="adi-mobile-only adi-native-button mt-3">
                                    @(entry.IsDirectory ? "Abrir pasta" : "Baixar arquivo")
                                </a>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
</MudContainer>

@code {

    [Parameter] public string? Version { get; set; }
    [SupplyParameterFromQuery(Name = "pasta")] public string? Directory { get; set; }
    private string? CurrentDirectory => Version is null ? Directory : $"COLETOR/{Version}";
    private string Title => Version is null ? "Downloads" : $"Atualização do coletor — {Version}";
    private string ParentUrl => CurrentDirectory?.Contains('/') == true
        ? $"downloads?pasta={Uri.EscapeDataString(CurrentDirectory[..CurrentDirectory.LastIndexOf('/')])}" : "downloads";
    private IReadOnlyList<DownloadEntry> _entries = [];
    private string? _error;

    protected override void OnParametersSet()
    {
        _error = null;
        try
        {
            _entries = Storage.List(CurrentDirectory);
            if (Version is not null)
                _entries = _entries.Where(x => !x.IsDirectory && x.Name.EndsWith(".apk", StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (ArgumentException) { _error = "O diretório solicitado não é válido."; }
        catch (Exception) { _error = "Os arquivos desta pasta estão indisponíveis no momento."; }
    }

    private static string EntryUrl(DownloadEntry entry) => entry.IsDirectory
        ? $"downloads?pasta={Uri.EscapeDataString(entry.Path)}"
        : "downloads/file/" + string.Join("/", entry.Path.Split('/').Select(Uri.EscapeDataString));

    private void Downloads()
    {

        Navigation.NavigateTo("/downloads/publicar");
    }
}
