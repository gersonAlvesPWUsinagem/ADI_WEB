@using Domain.Dtos.Portaria

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Login do operador</MudText>
    </TitleContent>
    <DialogContent>
        <MudAutocomplete T="PorteiroOperadorDto"
                         @bind-Value="_operadorSelecionado"
                         SearchFunc="SearchOperadores"
                         Label="Operador"
                         Placeholder="Selecione o operador..."
                         ToStringFunc="@(operador => operador?.Nome)"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Immediate=false
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary" />
        <MudTextField @bind-Value="_senha"
                      Label="Senha"
                      Adornment="Adornment.End"
                      AdornmentIcon="@PasswordInputIcon"
                      AdornmentAriaLabel="Mostrar senha"
                      OnAdornmentClick="TogglePasswordVisibility"
                      InputType="@PasswordInput"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      FullWidth="true"
                      Class="mt-3" />

    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="AlterarSenha" Disabled="@(_operadorSelecionado is null)">Alterar minha senha</MudButton>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Entrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IEnumerable<PorteiroOperadorDto> ListPorteiroOperador { get; set; } = [];
    [Parameter] public PorteiroOperadorDto? OperadorAtual { get; set; }
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private bool _isShow;
    private InputType PasswordInput = InputType.Password;

    private PorteiroOperadorDto? _operadorSelecionado;
    private string? _senha;

    protected override void OnInitialized() => _operadorSelecionado = OperadorAtual;

    private Task<IEnumerable<PorteiroOperadorDto>> SearchOperadores(string value, CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(value)
            ? ListPorteiroOperador
            : ListPorteiroOperador.Where(x => x.Nome?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
        return Task.FromResult(result);
    }

    private void Submit()
    {
        if (_operadorSelecionado is null || string.IsNullOrWhiteSpace(_senha))
            return;

        MudDialog.Close(DialogResult.Ok(new OperadorLoginResultDto
        {
            Operador = _operadorSelecionado,
            Senha = _senha
        }));
    }

    private void Cancel() => MudDialog.Cancel();

    private void AlterarSenha()
    {
        if (_operadorSelecionado is null)
            return;

        MudDialog.Close(DialogResult.Ok(new OperadorLoginResultDto
        {
            Operador = _operadorSelecionado,
            Senha = _senha,
            SolicitaAlteracaoSenha = true
        }));
    }

    private void TogglePasswordVisibility()
    {
        if (_isShow)
        {
            _isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            _isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
        StateHasChanged();
    }
}