@page "/ti/logs-api"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IApiErrorLogService ApiErrorLogService
@inject ILoginService LoginService

<PageTitle>Logs da API</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
    <FavoritosSkeleton @ref="_skeleton" @bind-Carregando="_carregandoInicial" />
</MudContainer>

@if (!_carregandoInicial)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
        <HeaderComponent Title="Logs de erros da API" Modulo="ModuloEnum.Comercial" Permission="116"
            ColorBtn1="Color.Primary"
            IconBtn1="@Icons.Material.Filled.Search"
            LevelBtn1="0"
            OnBtn1Click="CarregarAsync"
            TextBtn1="Pesquisar" />

        @if (_carregando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }

        <MudTable Items="_logs" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Md">
            <ToolBarContent>
                <MudPaper Class="d-flex flex-wrap flex-grow-1 gap-4" Elevation="0">
                        <MudAutocomplete T="ApiErrorPessoaDto"
                                         Value="_pessoaSelecionada"
                                         ValueChanged="SelecionarPessoaAsync"
                                         SearchFunc="PesquisarPessoasAsync"
                                         ToStringFunc="FormatarPessoa"
                                         Label="Colaborador"
                                         Placeholder="Digite ao menos 2 caracteres"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="2"
                                         DebounceInterval="300"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="false"
                                         CoerceValue="false"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                         NoItemsTemplate="@NenhumaPessoa" />

                        <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" Label="Data inicial" @bind-Date="_dataInicial"
                                       DateFormat="dd/MM/yyyy" Editable="true" />

                        <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" Label="Data final" @bind-Date="_dataFinal"
                                       DateFormat="dd/MM/yyyy" Editable="true" />
                </MudPaper>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Data</MudTh><MudTh>Tela</MudTh><MudTh>Nome do usuário</MudTh>
                <MudTh>Matrícula TB_USER</MudTh><MudTh>Matrícula VIEW_PESSOAS</MudTh><MudTh>Mensagem de erro</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Data">@context.DataHora.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Tela">@context.Tela</MudTd>
                <MudTd DataLabel="Nome do usuário">@context.UsuarioNome (@context.UsuarioLogin)</MudTd>
                <MudTd DataLabel="Matrícula TB_USER">@(context.MatriculaUsuario > 0 ? context.MatriculaUsuario.ToString() : "Não localizada")</MudTd>
                <MudTd DataLabel="Matrícula VIEW_PESSOAS">@(context.MatriculaPessoa?.ToString() ?? "Não localizada")</MudTd>
                <MudTd DataLabel="Mensagem de erro">@context.MensagemErro</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">
                    Nenhum erro encontrado entre @DataInicial.ToString("dd/MM/yyyy") e @DataFinal.ToString("dd/MM/yyyy").
                </MudText>
            </NoRecordsContent>
            <PagerContent><MudTablePager RowsPerPageString="Registros por página" /></PagerContent>
        </MudTable>
    </MudContainer>
}

@code {
    private DateTime? _dataInicial = DateTime.Today;
    private DateTime? _dataFinal = DateTime.Today;
    private List<ApiErrorLogDto> _logs = [];
    private ApiErrorPessoaDto? _pessoaSelecionada;
    private bool _carregandoInicial = true;
    private bool _carregando;
    private bool _acessoPermitido;
    private FavoritosSkeleton? _skeleton;
    private DateTime DataInicial => _dataInicial?.Date ?? DateTime.Today;
    private DateTime DataFinal => _dataFinal?.Date ?? DateTime.Today;
    private RenderFragment NenhumaPessoa => builder =>
        builder.AddContent(0, "Nenhum colaborador encontrado.");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _skeleton is null) return;

        await _skeleton.IniciarAsync();
        try
        {
            var acesso = await LoginService.ValidarPermissaoAsync(ModuloEnum.Comercial, 116);
            var podeConsultar = acesso.Success &&
                                acesso.Value?.Any(x => x.Level >= 1) == true;

            if (!podeConsultar)
            {
                _snackbarComp.Message(
                    acesso.Message ?? "Acesso não autorizado aos logs de erros da API.",
                    Severity.Error,
                    Color.Error);
                await JSRuntime.InvokeVoidAsync("window.history.back");
                return;
            }

            _acessoPermitido = true;
            await CarregarAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível consultar os logs da API: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (_acessoPermitido)
                await _skeleton.FinalizarAsync();
        }
    }

    private async Task CarregarAsync()
    {
        if (_carregando) return;

        if (DataFinal < DataInicial)
        {
            Snackbar.Add("A data final não pode ser anterior à data inicial.", Severity.Warning);
            return;
        }

        _carregando = true;
        try
        {
            var matricula = _pessoaSelecionada?.Matricula.ToString();
            var resultado = await ApiErrorLogService.ListarAsync(DataInicial, DataFinal, matricula);
            if (resultado.Success) _logs = resultado.Value ?? [];
            else Snackbar.Add(resultado.Message ?? "Não foi possível consultar os logs da API.", Severity.Error);
        }
        finally { _carregando = false; }
    }

    private async Task<IEnumerable<ApiErrorPessoaDto>> PesquisarPessoasAsync(
        string texto,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(texto) || texto.Trim().Length < 2)
            return [];

        cancellationToken.ThrowIfCancellationRequested();
        var resultado = await ApiErrorLogService.PesquisarPessoasAsync(texto.Trim());
        cancellationToken.ThrowIfCancellationRequested();

        if (!resultado.Success)
        {
            Snackbar.Add(resultado.Message ?? "Não foi possível pesquisar os colaboradores.", Severity.Error);
            return [];
        }

        return resultado.Value ?? [];
    }

    private Task SelecionarPessoaAsync(ApiErrorPessoaDto? pessoa)
    {
        _pessoaSelecionada = pessoa;
        return Task.CompletedTask;
    }

    private static string FormatarPessoa(ApiErrorPessoaDto? pessoa)
    {
        if (pessoa is null)
            return string.Empty;

        return pessoa.Matricula == 0
            ? pessoa.Nome.ToUpperInvariant()
            : $"{pessoa.Nome.ToUpperInvariant()} - {pessoa.Matricula}";
    }
}
