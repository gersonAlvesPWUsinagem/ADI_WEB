    #endregion

    #region [ Mascaras ]

    private readonly PatternMask _telefoneMask = new PatternMask("(00) 00000-0000")
    {
        MaskChars = new[] { new MaskChar('0', @"\d") },
        Placeholder = '_'
    };

    private readonly PatternMask _cpfMask = new PatternMask("000.000.000-00")
    {
        MaskChars = new[] { new MaskChar('0', @"\d") },
        Placeholder = '_'
    };

    private readonly PatternMask _cnpjMask = new PatternMask("00.000.000/0000-00")
    {
        MaskChars = new[] { new MaskChar('0', @"\d") },
        Placeholder = '_'
    };

    private readonly PatternMask _rgMask = new PatternMask("00.000.000-a")
    {
        MaskChars = new[] {
            new MaskChar('0', @"\d"),
            new MaskChar('a', @"[0-9xX]")
        },
        Placeholder = '_'
    };

    private PatternMask ObterMascaraSelecionada()
    {
        return _tipoDocumento switch
        {
            "CPF" => _cpfMask,
            "CNPJ" => _cnpjMask,
            "RG" => _rgMask,
            _ => _cpfMask
        };
    }

    #endregion
}